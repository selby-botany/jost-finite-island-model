#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
image=${GITLEAKS_IMAGE:-zricethezav/gitleaks}
default_digest=sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
digest=${GITLEAKS_IMAGE_DIGEST:-${default_digest}}

exec docker run --rm \
    --volume "${root}:/workspace" \
    --workdir /workspace \
    "${image}@${digest}" "$@"
