#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
image=${MARKDOWNLINT_IMAGE:-davidanson/markdownlint-cli2}
default_digest=sha256:0ed9a5f4c77ef447da2a2ac6e67caf74b214a7f80288819565e8b7d2ac148fe5
digest=${MARKDOWNLINT_IMAGE_DIGEST:-${default_digest}}

exec docker run --rm \
    --volume "${root}:/workspace" \
    --workdir /workspace \
    "${image}@${digest}" "$@"
