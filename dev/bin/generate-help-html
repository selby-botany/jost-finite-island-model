#!/usr/bin/env python3
"""Generate bundled desktop help from the Markdown documentation.

Renders every topic listed in doc/help-topics.json as an HTML fragment
in src/fim/gui/webui/help/<topic>.html, and writes two manifests beside
them: topics.json (the Help home's groups and topics) and
search-index.json (one entry per section, for offline search). These
pages are available offline. Links between bundled pages stay in the
application; links to other documentation and source open in the system
browser.

Edit the Markdown sources, then regenerate the committed HTML.
TeX math is converted to native MathML at build time, without runtime
scripts, fonts, or network requests.

Usage:
    dev/bin/generate-help-html
    dev/bin/generate-help-html --output-dir /some/scratch/directory

With no arguments, replaces the committed fragments. --output-dir
writes to a separate directory for preview or freshness validation.
"""

from __future__ import annotations

import argparse
import html
import importlib.util
import json
import os
import re
import sys
from collections import Counter
from collections.abc import Sequence
from pathlib import Path
from re import Match
from typing import Any
from xml.etree import ElementTree

ROOT = Path(__file__).resolve().parents[2]

_REEXEC_SENTINEL = "_FIM_GENERATE_HELP_HTML_REEXEC"


def _ensure_project_interpreter() -> None:
    """Re-exec under this repository's own Python if `markdown_it` is not
    installed for whichever interpreter this process is already running.

    This script's `#!/usr/bin/env python3` shebang resolves whatever
    `python3` happens to be first on the caller's own `PATH` -- for a
    plain shell that never ran `source .venv-312/bin/activate` (or
    activated some *other* worktree's own `.venv-312`, a mistake a
    background agent has made more than once this session), that is very
    unlikely to be a Python with this project's `[dev]` extra, and
    therefore `markdown-it-py`, installed. Rather than depend on that
    activation step at all, the one already-active interpreter is used
    as-is when it already has the package (so an already-activated,
    valid venv sees no behavior change); otherwise this process re-execs
    itself under `bin/python3` -- the same repository-relative wrapper
    `bin/pydoc-markdown`, `bin/mypy`, `bin/ruff`, and `bin/pytest`
    already resolve through -- which finds a real project virtualenv
    purely from the repository's own path, with no dependency on shell
    activation, and exits with its own clear, actionable message if none
    exists at all. One rule, applied consistently, rather than a
    "sometimes uses PATH, sometimes doesn't" hybrid.

    The `_REEXEC_SENTINEL` environment variable guards against looping
    forever if the resolved interpreter *still* lacks the package (for
    example, a `bin/python3` PATH fallback that finds some unrelated
    system Python 3.12+): the second attempt reports a plain, specific
    error instead of re-execing again.
    """
    if importlib.util.find_spec("markdown_it") is not None:
        return

    if os.environ.get(_REEXEC_SENTINEL) == "1":
        sys.stderr.write(
            f"generate-help-html: markdown_it is not installed under "
            f"{sys.executable}\n"
            "Install the project's dev dependencies: python -m pip "
            'install -e ".[dev]"\n'
        )
        raise SystemExit(1)

    project_python = ROOT / "bin" / "python3"
    if not project_python.is_file():
        sys.stderr.write(
            f"generate-help-html: {project_python} not found -- run this "
            "script from within the jost-finite-island-model repository\n"
        )
        raise SystemExit(1)

    env = dict(os.environ)
    env[_REEXEC_SENTINEL] = "1"
    script = str(Path(__file__).resolve())
    os.execve(str(project_python), [str(project_python), script, *sys.argv[1:]], env)


_ensure_project_interpreter()

import markdown_it  # noqa: E402 -- must follow the interpreter bootstrap above
from latex2mathml.converter import convert  # noqa: E402
from markdown_it.renderer import RendererHTML  # noqa: E402
from markdown_it.token import Token  # noqa: E402
from markdown_it.utils import EnvType, OptionsDict  # noqa: E402

sys.path.insert(0, str(ROOT / "dev" / "lib"))
from docslug import (  # noqa: E402 -- must follow the sys.path insert above
    HTML_TAG_PATTERN,
    anchor_for_text,
)

DOC_DIR = ROOT / "doc"
HELP_DIR = ROOT / "src" / "fim" / "gui" / "webui" / "help"
REGISTRY_PATH = DOC_DIR / "help-topics.json"
REPO_URL = "https://github.com/selby-botany/jost-finite-island-model"
TOPIC_ID_PATTERN = re.compile(r"^[a-z][a-z0-9-]*$")
TOPICS_MANIFEST = "topics.json"
SEARCH_INDEX = "search-index.json"
# Search text per section is capped so the index stays small enough to
# load on first use; headings and the opening text carry most matches.
SEARCH_TEXT_LIMIT = 1200


def load_registry(path: Path = REGISTRY_PATH) -> dict[str, list[dict[str, Any]]]:
    """Read and validate the help topic registry.

    Args:
        path: The registry JSON file.

    Returns:
        The parsed registry, with `groups` and `topics` lists.

    Raises:
        ValueError: A topic has a malformed or duplicate id, an unknown
            group, or a source file that does not exist.
    """
    registry: dict[str, list[dict[str, Any]]] = json.loads(
        path.read_text(encoding="utf-8")
    )
    group_ids = {group["id"] for group in registry["groups"]}
    seen: set[str] = set()
    for topic in registry["topics"]:
        topic_id = topic["id"]
        if not TOPIC_ID_PATTERN.fullmatch(topic_id) or topic_id in seen:
            raise ValueError(f"Invalid or duplicate help topic id: {topic_id}")
        seen.add(topic_id)
        if topic["group"] not in group_ids:
            raise ValueError(
                f"Help topic {topic_id} has unknown group {topic['group']}"
            )
        if not (ROOT / topic["source"]).is_file():
            raise ValueError(
                f"Help topic {topic_id} source not found: {topic['source']}"
            )
    return registry


REGISTRY = load_registry()
TOPIC_FOR_PATH: dict[Path, str] = {
    (ROOT / str(topic["source"])).resolve(): str(topic["id"])
    for topic in REGISTRY["topics"]
}

# A short note prepended to two reference fragments. `usage.md` is the
# command-line reference; desktop readers reach it from Help but have
# their own guide. `configuration.md` names YAML keys; Configure shows
# labels, so the note points at the label-to-key table.
_TOPIC_NOTE: dict[str, str] = {
    "usage": (
        '<div class="help-gui-note"><p><strong>Command-line reference</strong> '
        "This page documents the <code>fim</code> commands. For the desktop "
        'screens, see the <a href="#" data-fim-help="gui-overview" '
        'data-fim-anchor="">desktop app guide</a>.</p></div>'
    ),
    "configuration": (
        '<div class="help-gui-note"><p><strong>Configuration reference</strong> '
        "This page lists YAML keys, types, defaults, and constraints. "
        'The <a href="#" data-fim-help="gui-configure" '
        'data-fim-anchor="field-and-key-correspondence">Configure field '
        "table</a> maps each desktop control to its key.</p></div>"
    ),
}


# ---------------------------------------------------------------------------
# Math: preserve legacy identifiers, convert TeX to offline native MathML.
# ---------------------------------------------------------------------------

_FENCE_PATTERN = re.compile(r"```.*?```", re.DOTALL)
_CODE_SPAN_PATTERN = re.compile(r"`[^`]*`")
_MATH_PATTERN = re.compile(r"\$([^$\n]+)\$")
_IDENTIFIER = r"[A-Za-z]\w*"
_BARE_IDENTIFIER_PATTERN = re.compile(rf"^{_IDENTIFIER}$")
# TeX permits an unbraced single-character subscript; longer subscripts
# require braces. Keep legacy snake_case identifiers such as n_replicates whole.
_SUBSCRIPTED_IDENTIFIER_PATTERN = re.compile(
    rf"^({_IDENTIFIER})_(\{{\w+\}}|[A-Za-z0-9])$"
)

_EQUATION_TAG_PATTERN = re.compile(r"\\tag\{([^{}]+)\}\s*$")


def render_tex(expr: str, *, display: bool = False) -> str:
    """Convert TeX to MathML; reject unsupported commands rather than print them."""
    markup = convert(expr, display="block" if display else "inline")
    root = ElementTree.fromstring(markup)
    if any("\\" in text for text in root.itertext()):
        raise ValueError(f"Unsupported TeX command in help equation: {expr}")
    return markup


def render_display_math(expr: str) -> str:
    """Render a math fence and its optional trailing equation tag separately."""
    tag = _EQUATION_TAG_PATTERN.search(expr)
    equation = expr if tag is None else expr[: tag.start()]
    markup = render_tex(equation.strip(), display=True)
    label = (
        ""
        if tag is None
        else f'<span class="equation-tag">({html.escape(tag.group(1))})</span>'
    )
    return f'<div class="math-display">{markup}{label}</div>\n'


def render_math(expr: str) -> str:
    """Render one `$expr$` capture's inner text as an HTML fragment.

    A bare identifier (`$N$`) becomes `<var>N</var>`; an identifier with
    one subscript (`$N_i$`, `$N_{i}$`) becomes `<var>N</var><sub>i</sub>`.
    Legacy identifiers retain their existing HTML representation.
    Expressions and TeX commands use native MathML.
    """
    stripped = expr.strip()
    subscripted = _SUBSCRIPTED_IDENTIFIER_PATTERN.fullmatch(stripped)
    if subscripted:
        base, subscript = subscripted.groups()
        subscript = subscript.strip("{}")
        return f"<var>{html.escape(base)}</var><sub>{html.escape(subscript)}</sub>"
    if _BARE_IDENTIFIER_PATTERN.fullmatch(stripped):
        return f"<var>{html.escape(stripped)}</var>"
    return render_tex(stripped)


def _apply_math_outside_code_spans(segment: str) -> str:
    """Apply `render_math` to every `$expr$` outside an inline code span."""

    def substitute(match: Match[str]) -> str:
        return render_math(match.group(1))

    parts: list[str] = []
    cursor = 0
    for code_match in _CODE_SPAN_PATTERN.finditer(segment):
        parts.append(
            _MATH_PATTERN.sub(substitute, segment[cursor : code_match.start()])
        )
        parts.append(code_match.group(0))
        cursor = code_match.end()
    parts.append(_MATH_PATTERN.sub(substitute, segment[cursor:]))
    return "".join(parts)


def render_inline_math(markdown_text: str) -> str:
    """Replace every `$expr$` in `markdown_text` outside a fence or code span.

    A fenced code block is skipped wholesale first, then every remaining
    segment is scanned for inline code spans the same way -- the same
    two-layer "code-span content is not markup" protection `anchor_for`
    already uses for one heading line, generalized here to a whole
    document (design §4.1's own "the same code-span-protects-content
    technique `anchor_for()` already uses").
    """
    parts: list[str] = []
    cursor = 0
    for fence_match in _FENCE_PATTERN.finditer(markdown_text):
        parts.append(
            _apply_math_outside_code_spans(markdown_text[cursor : fence_match.start()])
        )
        parts.append(fence_match.group(0))
        cursor = fence_match.end()
    parts.append(_apply_math_outside_code_spans(markdown_text[cursor:]))
    return "".join(parts)


# ---------------------------------------------------------------------------
# Header anchors: the same GitHub-compatible slugger `check-doc-links`
# already trusts, not a second, possibly-drifting one (design §4.1).
# ---------------------------------------------------------------------------

_HEADER_PATTERN = re.compile(r"<(h[1-6])>(.*?)</\1>", re.DOTALL)


def inject_header_ids(rendered_html: str) -> str:
    """Add a GitHub-compatible `id` to every rendered heading.

    Markdown has already been rendered, so its emphasis delimiters are
    gone. Strip HTML tags and decode entities to recover the literal
    heading text, then use the shared slug normalization without parsing
    Markdown again: a code span's leading or trailing underscores are
    literal characters, not emphasis.
    """
    seen: Counter[str] = Counter()

    def substitute(match: Match[str]) -> str:
        tag, inner = match.group(1), match.group(2)
        base = anchor_for_text(html.unescape(HTML_TAG_PATTERN.sub("", inner)))
        duplicate = seen[base]
        seen[base] += 1
        anchor = base if duplicate == 0 else f"{base}-{duplicate}"
        return f'<{tag} id="{anchor}">{inner}</{tag}>'

    return _HEADER_PATTERN.sub(substitute, rendered_html)


# ---------------------------------------------------------------------------
# Link rewriting (design §4.3): every `<a href>` is routed so nothing ever
# lets pywebview's own window navigate away from `index.html` (§4.3's own
# "an unguarded link is a real way to break the app, not just a rough
# edge"). No bare `href` ever reaches the page unrewritten -- every anchor
# gets `href="#"` plus a `data-fim-*` attribute `webui/screens/help.js`'s
# own delegated click handler reads, so a click with JavaScript disabled or
# not yet wired stays inert rather than silently working around this.
# ---------------------------------------------------------------------------

_ANCHOR_HREF_PATTERN = re.compile(r'<a href="([^"]*)">')


def _rewrite_href(match: Match[str], base_dir: Path) -> str:
    """Route one link: bundled topic, same-page anchor, or system browser.

    Args:
        match: An `<a href="...">` match.
        base_dir: The directory of the Markdown source that contains the
            link; relative links resolve against it, as on GitHub.

    Returns:
        The rewritten opening tag.
    """
    target = html.unescape(match.group(1))
    if target.startswith(("http://", "https://", "mailto:")):
        return f'<a href="#" data-fim-external="{html.escape(target, quote=True)}">'
    path_part, _separator, fragment = target.partition("#")
    if not path_part:
        # Same-document anchor: left as native browser scroll behavior.
        return match.group(0)
    resolved = (base_dir / path_part).resolve()
    target_topic = TOPIC_FOR_PATH.get(resolved)
    if target_topic is not None:
        return (
            f'<a href="#" data-fim-help="{html.escape(target_topic, quote=True)}" '
            f'data-fim-anchor="{html.escape(fragment, quote=True)}">'
        )
    try:
        doc_relative = resolved.relative_to(ROOT).as_posix()
    except ValueError:
        # Outside the checkout entirely (a malformed `../../` climb) --
        # link to the repository root rather than raise mid-render; a
        # broken link here is `check-doc-links`' job to catch against
        # the real source file, not this generator's.
        doc_relative = "README.md"
    external_url = f"{REPO_URL}/blob/main/{doc_relative}"
    if fragment:
        external_url += f"#{fragment}"
    return f'<a href="#" data-fim-external="{html.escape(external_url, quote=True)}">'


def rewrite_links(rendered_html: str, base_dir: Path = DOC_DIR) -> str:
    """Rewrite every `<a href>` relative to the source's own directory."""
    return _ANCHOR_HREF_PATTERN.sub(
        lambda match: _rewrite_href(match, base_dir), rendered_html
    )


def render_doc(topic_id: str) -> str:
    """Render one registered topic's Markdown source to an HTML fragment."""
    source_path = next(
        path for path, candidate in TOPIC_FOR_PATH.items() if candidate == topic_id
    )
    source = source_path.read_text(encoding="utf-8")
    source = render_inline_math(source)
    renderer = markdown_it.MarkdownIt("gfm-like", {"html": True}).disable("linkify")

    def render_fence(
        html_renderer: RendererHTML,
        tokens: Sequence[Token],
        index: int,
        options: OptionsDict,
        env: EnvType,
    ) -> str:
        """Convert math fences, leaving programming examples unchanged."""
        token = tokens[index]
        if token.info.strip() == "math":
            return render_display_math(token.content)
        return html_renderer.fence(tokens, index, options, env)

    renderer.add_render_rule("fence", render_fence)
    rendered = renderer.render(source)
    rendered = inject_header_ids(rendered)
    rendered = rewrite_links(rendered, source_path.parent)
    note = _TOPIC_NOTE.get(topic_id)
    return rendered if note is None else note + rendered


_SECTION_HEADING_PATTERN = re.compile(r'<(h[1-3]) id="([^"]*)">(.*?)</\1>', re.DOTALL)
_MATH_ELEMENT_PATTERN = re.compile(r"<math\b.*?</math>", re.DOTALL)
_WHITESPACE_PATTERN = re.compile(r"\s+")


def _plain_text(fragment: str) -> str:
    """Reduce an HTML fragment to collapsed plain text, dropping MathML."""
    without_math = _MATH_ELEMENT_PATTERN.sub(" ", fragment)
    text = html.unescape(HTML_TAG_PATTERN.sub(" ", without_math))
    return _WHITESPACE_PATTERN.sub(" ", text).strip()


def search_entries(topic_id: str, fragment: str) -> list[dict[str, str]]:
    """Split a rendered topic into one search entry per h1-h3 section.

    Args:
        topic_id: The registered topic id.
        fragment: The topic's rendered HTML.

    Returns:
        Entries with `topic`, `anchor`, `heading`, and `text`. The h1
        entry's anchor is empty, meaning the top of the page.
    """
    headings = list(_SECTION_HEADING_PATTERN.finditer(fragment))
    entries: list[dict[str, str]] = []
    for index, heading in enumerate(headings):
        end = (
            headings[index + 1].start() if index + 1 < len(headings) else len(fragment)
        )
        heading_text = _plain_text(heading.group(3))
        if heading_text == "Contents":
            continue
        entries.append(
            {
                "anchor": "" if heading.group(1) == "h1" else heading.group(2),
                "heading": heading_text,
                "text": _plain_text(fragment[heading.end() : end])[:SEARCH_TEXT_LIMIT],
                "topic": topic_id,
            }
        )
    return entries


def topics_manifest() -> dict[str, object]:
    """Return the Help home manifest: groups and topics without sources."""
    return {
        "groups": REGISTRY["groups"],
        "topics": [
            {key: value for key, value in topic.items() if key != "source"}
            for topic in REGISTRY["topics"]
        ],
    }


def _write_json(path: Path, value: object) -> None:
    """Write deterministic, compact JSON so regeneration is byte-stable."""
    text = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    path.write_text(text + "\n", encoding="utf-8")


def main(argv: list[str] | None = None) -> int:
    """Regenerate every registered topic and both manifests.

    Args:
        argv: Command-line arguments, excluding the program name. `None`
            (the default, used when run as a script) tells `argparse` to
            read `sys.argv[1:]` itself; a real list is used by tests and
            by callers like `pre-push` that invoke this in-process-
            equivalent shape via a subprocess with explicit arguments.

    Returns:
        0 after writing every topic's `<topic>.html`, `topics.json`, and
        `search-index.json` in the target directory, and removing any
        `.html` fragment left from a topic no longer registered.
    """
    parser = argparse.ArgumentParser(
        prog="generate-help-html",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=HELP_DIR,
        help=(
            "write the generated HTML here instead of the committed "
            f"{HELP_DIR.relative_to(ROOT)}/ directory"
        ),
    )
    args = parser.parse_args(argv)
    output_dir = args.output_dir
    output_dir.mkdir(parents=True, exist_ok=True)
    index: list[dict[str, str]] = []
    written: set[str] = set()
    for topic in REGISTRY["topics"]:
        topic_id = str(topic["id"])
        fragment = render_doc(topic_id)
        target = output_dir / f"{topic_id}.html"
        target.write_text(fragment, encoding="utf-8")
        written.add(target.name)
        index.extend(search_entries(topic_id, fragment))
        print(f"generate-help-html: wrote {target}")
    for stale in output_dir.glob("*.html"):
        if stale.name not in written:
            stale.unlink()
            print(f"generate-help-html: removed {stale}")
    _write_json(output_dir / TOPICS_MANIFEST, topics_manifest())
    _write_json(output_dir / SEARCH_INDEX, index)
    print(f"generate-help-html: wrote {TOPICS_MANIFEST} and {SEARCH_INDEX}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
