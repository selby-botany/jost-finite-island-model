#!/usr/bin/env python3
"""Render Tier 1 docs into the GUI's Help screen (design doc
`20260822-claude-sonnet-5-in-app-help-design.md` §4.1).

Converts `doc/usage.md` and `doc/configuration.md` -- the two operational
docs with no real LaTeX macros (`\\frac`, `\\sum`, ...), only bare
`$expr$`-style inline math (design §2.3's own math-complexity survey) --
into body-only HTML fragments under `src/fim/gui/webui/help/`, once at
commit/build time, not on every app launch (§4.1's own "build time, not
runtime"). Every other doc stays a Tier 2 link out to GitHub, unrendered.

Committed like `src/fim/API.md`: regenerated by `dev/git-hooks/pre-commit`,
freshness-checked by `dev/git-hooks/pre-push` and `./build --ci` -- the
same generated-and-committed-derived-doc pattern `dev/bin/generate-api-
docs` already established, extended here rather than reinvented.
"""

from __future__ import annotations

import html
import re
import sys
from collections import Counter
from pathlib import Path
from re import Match

from markdown_it import MarkdownIt

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "dev" / "lib"))
from docslug import anchor_for  # noqa: E402 -- must follow the sys.path insert above

DOC_DIR = ROOT / "doc"
HELP_DIR = ROOT / "src" / "fim" / "gui" / "webui" / "help"
REPO_URL = "https://github.com/selby-botany/jost-finite-island-model"
_OUTPUT_DIR_ARGC = 2

# Tier 1 (design §3.1): embedded, rendered in-app. Every other `doc/*.md`
# file is Tier 2 (design §3.2) -- linked out to GitHub's own rendering at
# `main`, never converted here.
EMBEDDED_DOCS: tuple[tuple[str, str], ...] = (
    ("usage", "usage.md"),
    ("configuration", "configuration.md"),
)
EMBEDDED_FILENAMES = {filename for _, filename in EMBEDDED_DOCS}
SLUG_FOR_FILENAME = {filename: slug for slug, filename in EMBEDDED_DOCS}


# ---------------------------------------------------------------------------
# Math: a purpose-built inline handler (design §4.2), not a LaTeX engine --
# no doc in `EMBEDDED_DOCS` contains `\frac`, `\sum`, or any other macro
# needing one (design §2.3).
# ---------------------------------------------------------------------------

_FENCE_PATTERN = re.compile(r"```.*?```", re.DOTALL)
_CODE_SPAN_PATTERN = re.compile(r"`[^`]*`")
_MATH_PATTERN = re.compile(r"\$([^$\n]+)\$")
_IDENTIFIER = r"[A-Za-z]\w*"
_BARE_IDENTIFIER_PATTERN = re.compile(rf"^{_IDENTIFIER}$")
# Braces are required, not optional: every real subscript in these two
# docs is written `X_{sub}` (`N_{i}`, `mu_{b}`, `H_{ST}`); a brace-less
# `X_sub` shape is, every time it actually occurs, a snake_case code
# identifier in its own right (`$max_generations$`, `$n_replicates$`) --
# treating it as base-plus-subscript would wrongly split a single
# variable name in two. Confirmed by grepping every real `$expr$` in
# both embedded docs before choosing this rule, not assumed.
_SUBSCRIPTED_IDENTIFIER_PATTERN = re.compile(rf"^({_IDENTIFIER})_\{{(\w+)\}}$")

# The one LaTeX macro that actually recurs across `EMBEDDED_DOCS` (`usage.md`
# alone uses `\sim` four times, e.g. "$D \\sim 0.100$") -- a small, explicit
# lookup table, not a general macro interpreter; every other backslash
# sequence renders verbatim (escaped), never guessed at.
_MATH_SYMBOL_REPLACEMENTS: dict[str, str] = {r"\sim": "≈"}


def render_math(expr: str) -> str:
    """Render one `$expr$` capture's inner text as an HTML fragment.

    A bare identifier (`$N$`) becomes `<var>N</var>`; an identifier with
    one subscript (`$N_i$`, `$N_{i}$`) becomes `<var>N</var><sub>i</sub>`.
    Everything else -- comparisons (`$d < 2$`), arithmetic
    (`$max_generations + 1$`), snake_case identifiers with more than one
    underscore (`$initial_allele_count$`) that a subscript-hungry regex
    would otherwise mangle -- renders verbatim, escaped, inside a
    `<code class="math-expr">` span: correct and safe is preferred here
    over clever and wrong for content this varied (confirmed by grepping
    every real `$expr$` in both embedded docs before writing this, not
    assumed from the smaller sample the design doc itself worked from).
    """
    stripped = expr.strip()
    subscripted = _SUBSCRIPTED_IDENTIFIER_PATTERN.fullmatch(stripped)
    if subscripted:
        base, subscript = subscripted.groups()
        return f"<var>{html.escape(base)}</var><sub>{html.escape(subscript)}</sub>"
    if _BARE_IDENTIFIER_PATTERN.fullmatch(stripped):
        return f"<var>{html.escape(stripped)}</var>"
    text = stripped
    for macro, replacement in _MATH_SYMBOL_REPLACEMENTS.items():
        text = text.replace(macro, replacement)
    return f'<code class="math-expr">{html.escape(text)}</code>'


def _apply_math_outside_code_spans(segment: str) -> str:
    """Apply `render_math` to every `$expr$` outside an inline code span."""

    def substitute(match: Match[str]) -> str:
        return render_math(match.group(1))

    parts: list[str] = []
    cursor = 0
    for code_match in _CODE_SPAN_PATTERN.finditer(segment):
        parts.append(
            _MATH_PATTERN.sub(substitute, segment[cursor : code_match.start()])
        )
        parts.append(code_match.group(0))
        cursor = code_match.end()
    parts.append(_MATH_PATTERN.sub(substitute, segment[cursor:]))
    return "".join(parts)


def render_inline_math(markdown_text: str) -> str:
    """Replace every `$expr$` in `markdown_text` outside a fence or code span.

    A fenced code block is skipped wholesale first, then every remaining
    segment is scanned for inline code spans the same way -- the same
    two-layer "code-span content is not markup" protection `anchor_for`
    already uses for one heading line, generalized here to a whole
    document (design §4.1's own "the same code-span-protects-content
    technique `anchor_for()` already uses").
    """
    parts: list[str] = []
    cursor = 0
    for fence_match in _FENCE_PATTERN.finditer(markdown_text):
        parts.append(
            _apply_math_outside_code_spans(markdown_text[cursor : fence_match.start()])
        )
        parts.append(fence_match.group(0))
        cursor = fence_match.end()
    parts.append(_apply_math_outside_code_spans(markdown_text[cursor:]))
    return "".join(parts)


# ---------------------------------------------------------------------------
# Header anchors: the same GitHub-compatible slugger `check-doc-links`
# already trusts, not a second, possibly-drifting one (design §4.1).
# ---------------------------------------------------------------------------

_HEADER_PATTERN = re.compile(r"<(h[1-6])>(.*?)</\1>", re.DOTALL)


def inject_header_ids(rendered_html: str) -> str:
    """Add a GitHub-compatible `id` to every rendered heading.

    `anchor_for` strips inline HTML tags before slugifying (its own
    first step), so it reads straight through `render_math`'s own
    injected `<var>`/`<code>` tags to the heading's real text -- the
    identical anchor a raw-Markdown `### $N$` heading would get from
    `check-doc-links` itself, with no separate math-aware slug logic
    needed here.
    """
    seen: Counter[str] = Counter()

    def substitute(match: Match[str]) -> str:
        tag, inner = match.group(1), match.group(2)
        base = anchor_for(inner)
        duplicate = seen[base]
        seen[base] += 1
        anchor = base if duplicate == 0 else f"{base}-{duplicate}"
        return f'<{tag} id="{anchor}">{inner}</{tag}>'

    return _HEADER_PATTERN.sub(substitute, rendered_html)


# ---------------------------------------------------------------------------
# Link rewriting (design §4.3): every `<a href>` is routed so nothing ever
# lets pywebview's own window navigate away from `index.html` (§4.3's own
# "an unguarded link is a real way to break the app, not just a rough
# edge"). No bare `href` ever reaches the page unrewritten -- every anchor
# gets `href="#"` plus a `data-fim-*` attribute `webui/screens/help.js`'s
# own delegated click handler reads, so a click with JavaScript disabled or
# not yet wired stays inert rather than silently working around this.
# ---------------------------------------------------------------------------

_ANCHOR_HREF_PATTERN = re.compile(r'<a href="([^"]*)">')


def _rewrite_href(match: Match[str]) -> str:
    target = html.unescape(match.group(1))
    if target.startswith(("http://", "https://", "mailto:")):
        return f'<a href="#" data-fim-external="{html.escape(target, quote=True)}">'
    path_part, _separator, fragment = target.partition("#")
    if not path_part:
        # Same-document anchor: left as native browser scroll behavior.
        return match.group(0)
    resolved = (DOC_DIR / path_part).resolve()
    if resolved.name in EMBEDDED_FILENAMES:
        target_slug = SLUG_FOR_FILENAME[resolved.name]
        return (
            f'<a href="#" data-fim-help="{html.escape(target_slug, quote=True)}" '
            f'data-fim-anchor="{html.escape(fragment, quote=True)}">'
        )
    try:
        doc_relative = resolved.relative_to(ROOT).as_posix()
    except ValueError:
        # Outside the checkout entirely (a malformed `../../` climb) --
        # link to the repository root rather than raise mid-render; a
        # broken Tier 2 link here is still `check-doc-links`' own job to
        # catch against the real source file, not this generator's.
        doc_relative = "README.md"
    external_url = f"{REPO_URL}/blob/main/{doc_relative}"
    if fragment:
        external_url += f"#{fragment}"
    return f'<a href="#" data-fim-external="{html.escape(external_url, quote=True)}">'


def rewrite_links(rendered_html: str) -> str:
    """Rewrite every `<a href>` per the Tier 1 / Tier 2 / external table above."""
    return _ANCHOR_HREF_PATTERN.sub(_rewrite_href, rendered_html)


def render_doc(filename: str) -> str:
    """Render one embedded doc's Markdown source to a body-only HTML fragment."""
    source = (DOC_DIR / filename).read_text(encoding="utf-8")
    source = render_inline_math(source)
    renderer = MarkdownIt("gfm-like", {"html": True}).disable("linkify")
    rendered = renderer.render(source)
    rendered = inject_header_ids(rendered)
    return rewrite_links(rendered)


def main(argv: list[str] | None = None) -> int:
    """Regenerate every Tier 1 doc's HTML fragment.

    Args:
        argv: `["--output-dir", PATH]` writes to `PATH` instead of the
            committed `webui/help/` directory -- `./build --ci`'s own
            freshness check (`dev/bin/generate-api-docs`'s identical
            pattern) renders into a scratch directory and diffs it
            against the committed tree, rather than overwriting it
            in place before confirming it still matches.
    """
    args = argv if argv is not None else sys.argv[1:]
    output_dir = HELP_DIR
    if args:
        if len(args) != _OUTPUT_DIR_ARGC or args[0] != "--output-dir":
            print("usage: generate-help-html [--output-dir PATH]", file=sys.stderr)
            return 2
        output_dir = Path(args[1])
    output_dir.mkdir(parents=True, exist_ok=True)
    for slug, filename in EMBEDDED_DOCS:
        fragment = render_doc(filename)
        target = output_dir / f"{slug}.html"
        target.write_text(fragment, encoding="utf-8")
        print(f"generate-help-html: wrote {target}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
