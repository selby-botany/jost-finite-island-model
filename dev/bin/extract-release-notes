#!/usr/bin/env python3
"""Extract one version's release notes from a Keep a Changelog file.

`CHANGELOG.md` is written in the "Keep a Changelog" format: one `##
[X.Y.Z]` heading per released version, each followed by the bullet points
describing what changed in that release, down to the next `##` heading or
a trailing block of `[version]: URL` reference links at the very end of
the file.

This script pulls out just one version's section -- the bullet points
between its own `## [X.Y.Z]` heading and whichever comes next (another
release heading, or the reference-link block) -- and prints exactly that
text, with the surrounding heading and everything else stripped away.

Why this exists: when a GitHub Release is published for a tag, GitHub
needs release notes to show on that release's own page. Hand-copying
the relevant `CHANGELOG.md` section into the release form every time
is both tedious and a chance to copy the wrong section, or to let the
two texts quietly drift apart over releases. Since the changelog is
already the authoritative, hand-written record of what changed --
maintained as part of normal development, not written specially for
each release -- this script is run once per release, by the automated
release workflow, to generate the GitHub Release body directly from it.
There should never be a reason to maintain the release notes as a
second, separate piece of writing.

Usage:
    dev/bin/extract-release-notes v1.2.0
    dev/bin/extract-release-notes 1.2.0 --changelog path/to/CHANGELOG.md

The version tag's leading "v" (if present, as in a real Git tag like
"v1.2.0") is stripped automatically before searching, since
`CHANGELOG.md`'s own headings are written as `## [1.2.0]`, without the
"v". Prints the extracted section to stdout; prints an error to stderr
and exits with status 1 if the changelog cannot be read, has no section
for the requested version, or that section is empty.
"""

from __future__ import annotations

import argparse
import re
import sys
from collections.abc import Sequence
from pathlib import Path

RELEASE_HEADING = re.compile(r"^## \[(?P<version>[0-9]+\.[0-9]+\.[0-9]+)](?: - .+)?$")
RELEASE_REFERENCE = re.compile(r"^\[(?:Unreleased|[0-9]+\.[0-9]+\.[0-9]+)]:\s+\S+")


def extract_release_notes(changelog: str, version: str) -> str:
    """Return the body of one release section with one trailing newline."""
    selected: list[str] = []
    found = False

    for line in changelog.splitlines():
        heading = RELEASE_HEADING.match(line)
        if heading is not None:
            if found:
                break
            found = heading.group("version") == version
            continue
        if found:
            if RELEASE_REFERENCE.match(line):
                break
            selected.append(line)

    notes = "\n".join(selected).strip()
    if not found:
        raise ValueError(f"CHANGELOG.md has no [{version}] release section")
    if not notes:
        raise ValueError(f"CHANGELOG.md [{version}] release section is empty")
    return f"{notes}\n"


def main(argv: Sequence[str] | None = None) -> int:
    """Write the requested release section and return a process status."""
    # `description=__doc__`/`RawDescriptionHelpFormatter` together make
    # `--help` print the full module docstring above verbatim (its own
    # line breaks and blank lines preserved) instead of argparse's
    # default behavior of re-wrapping it into one dense paragraph.
    parser = argparse.ArgumentParser(
        prog="extract-release-notes",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("tag", help="release tag, such as v1.0.0")
    parser.add_argument(
        "--changelog",
        type=Path,
        default=Path("CHANGELOG.md"),
        help="changelog path (default: CHANGELOG.md)",
    )
    args = parser.parse_args(argv)
    version = args.tag.removeprefix("v")

    try:
        changelog = args.changelog.read_text(encoding="utf-8")
        notes = extract_release_notes(changelog, version)
    except (OSError, ValueError) as error:
        print(f"extract-release-notes: {error}", file=sys.stderr)
        return 1

    sys.stdout.write(notes)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
