#!/usr/bin/env python3
"""Extract one version's release notes from a Keep a Changelog file."""

from __future__ import annotations

import argparse
import re
import sys
from collections.abc import Sequence
from pathlib import Path

RELEASE_HEADING = re.compile(r"^## \[(?P<version>[0-9]+\.[0-9]+\.[0-9]+)](?: - .+)?$")
RELEASE_REFERENCE = re.compile(r"^\[(?:Unreleased|[0-9]+\.[0-9]+\.[0-9]+)]:\s+\S+")


def extract_release_notes(changelog: str, version: str) -> str:
    """Return the body of one release section with one trailing newline."""
    selected: list[str] = []
    found = False

    for line in changelog.splitlines():
        heading = RELEASE_HEADING.match(line)
        if heading is not None:
            if found:
                break
            found = heading.group("version") == version
            continue
        if found:
            if RELEASE_REFERENCE.match(line):
                break
            selected.append(line)

    notes = "\n".join(selected).strip()
    if not found:
        raise ValueError(f"CHANGELOG.md has no [{version}] release section")
    if not notes:
        raise ValueError(f"CHANGELOG.md [{version}] release section is empty")
    return f"{notes}\n"


def main(argv: Sequence[str] | None = None) -> int:
    """Write the requested release section and return a process status."""
    parser = argparse.ArgumentParser()
    parser.add_argument("tag", help="release tag, such as v1.0.0")
    parser.add_argument(
        "--changelog",
        type=Path,
        default=Path("CHANGELOG.md"),
        help="changelog path (default: CHANGELOG.md)",
    )
    args = parser.parse_args(argv)
    version = args.tag.removeprefix("v")

    try:
        changelog = args.changelog.read_text(encoding="utf-8")
        notes = extract_release_notes(changelog, version)
    except (OSError, ValueError) as error:
        print(f"extract-release-notes: {error}", file=sys.stderr)
        return 1

    sys.stdout.write(notes)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
