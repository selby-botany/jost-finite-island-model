#!/usr/bin/env python3
"""Validate local Markdown files, fragments, and inbound navigation."""

from __future__ import annotations

import re
import sys
from collections import Counter, defaultdict
from pathlib import Path
from urllib.parse import unquote

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "dev" / "lib"))
from docslug import anchor_for  # noqa: E402 -- must follow the sys.path insert above

LINK_PATTERN = re.compile(r"!?\[[^\]]*]\(([^)]+)\)")
HEADING_PATTERN = re.compile(r"^(#{1,6})\s+(.+?)\s*#?\s*$")
HTML_ID_PATTERN = re.compile(r'<a\s+id="([^"]+)"></a>')


def anchors_for(path: Path) -> set[str]:
    """Return all heading anchors, including duplicate suffixes."""
    text = path.read_text(encoding="utf-8")
    anchors: set[str] = set(HTML_ID_PATTERN.findall(text))
    counts: Counter[str] = Counter()
    for line in text.splitlines():
        match = HEADING_PATTERN.match(line)
        if match is None:
            continue
        base = anchor_for(match.group(2))
        duplicate = counts[base]
        anchors.add(base if duplicate == 0 else f"{base}-{duplicate}")
        counts[base] += 1
    return anchors


def markdown_files() -> tuple[Path, ...]:
    """Return tracked documentation candidates outside ignored work areas."""
    ignored = {
        ".attic",
        ".git",
        ".mypy_cache",
        ".pytest_cache",
        ".ruff_cache",
        ".tox",
        "build",
        "dist",
        "htmlcov",
        "site",
    }
    # doc/dev/ is scratch/review material, declared out of scope by its own
    # doc/.gitignore ("dev") rather than by name here — a bare "dev" entry
    # in `ignored` above would incorrectly also exclude the real, wanted
    # dev/git-hooks/README.md at the repository root.
    doc_dev = ROOT / "doc" / "dev"
    return tuple(
        sorted(
            path
            for path in ROOT.rglob("*.md")
            if not any(part in ignored for part in path.parts)
            and not any(part.startswith(".venv") for part in path.parts)
            and doc_dev not in path.parents
        )
    )


def validate() -> list[str]:
    """Return every local link, fragment, and orphan error."""
    files = markdown_files()
    file_set = {path.resolve() for path in files}
    anchor_cache = {path.resolve(): anchors_for(path) for path in files}
    inbound: defaultdict[Path, int] = defaultdict(int)
    errors: list[str] = []

    for source in files:
        text = source.read_text(encoding="utf-8")
        for raw_target in LINK_PATTERN.findall(text):
            target = raw_target.strip().split(maxsplit=1)[0].strip("<>")
            if target.startswith(("http://", "https://", "mailto:")):
                continue
            path_part, separator, fragment = target.partition("#")
            destination = (
                source.resolve()
                if not path_part
                else (source.parent / unquote(path_part)).resolve()
            )
            if not destination.exists():
                errors.append(f"{source.relative_to(ROOT)}: missing target {target}")
                continue
            if destination in file_set and destination != source.resolve():
                inbound[destination] += 1
            if (
                separator
                and destination.suffix.lower() == ".md"
                and unquote(fragment) not in anchor_cache.get(destination, set())
            ):
                errors.append(f"{source.relative_to(ROOT)}: missing anchor {target}")

    exempt = {
        (ROOT / "README.md").resolve(),
        (ROOT / "LICENSE.md").resolve(),
        (ROOT / "CHANGELOG.md").resolve(),
    }
    for path in files:
        resolved = path.resolve()
        if resolved not in exempt and inbound[resolved] == 0:
            errors.append(f"{path.relative_to(ROOT)}: orphan document")
    return errors


def main() -> int:
    """Print validation errors and return a process-style status."""
    errors = validate()
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1
    print("All local Markdown links, anchors, and documents are connected")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
