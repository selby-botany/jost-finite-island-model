#!/usr/bin/env python3
"""Validate local Markdown files, fragments, and inbound navigation.

Every `.md` file in this repository is checked three ways:

1. Every Markdown link (``[text](target)``) and image (``![alt](target)``)
   that points at a *local* file (not ``http://``/``https://``/``mailto:``)
   must actually resolve to a file that exists on disk. A link to a
   renamed or deleted file is caught here, at review time, instead of
   being discovered later by a reader clicking a dead link on GitHub.
2. A link with a ``#fragment`` (e.g. ``[see below](usage.md#run-a-
   simulation)``) must name a heading that actually exists in the target
   file. Headings are converted to the same URL-safe "slug" GitHub itself
   uses (spaces become hyphens, punctuation is stripped, and so on), so
   this check reproduces GitHub's own anchor behavior rather than a
   simplified approximation of it.
3. Every Markdown file must be reachable by clicking through links
   starting from some other page (an "orphan" document, with nothing
   ever linking to it, is almost always a sign that a new page was
   written but never wired into the rest of the documentation set).
   `README.md`, `LICENSE.md`, and `CHANGELOG.md` are exempt, since a
   reader is expected to land on those directly rather than via a link
   from elsewhere in the repository.

Why this exists: this project's documentation is deliberately spread
across many small, cross-linked files (a top-level `README.md`, several
files under `doc/`, worked examples under `doc/examples/`, and so on)
rather than one long page, on the theory that a reader can follow links
to exactly the section they need. That only works if every link
actually goes somewhere and every page is actually reachable -- both of
which silently rot as files get renamed, moved, or split over time, with
no error from any tool that only checks that the Markdown itself is
*syntactically* well-formed (a linter like `markdownlint` does not know
whether a link's target file still exists). This script is the
authoritative check for that: it runs in `./build --ci` and this
project's `pre-push` git hook, and can also be run directly whenever you
add, rename, or delete a documentation file, to catch a broken cross-
reference before it is committed.

Usage:
    dev/bin/check-doc-links

Takes no arguments -- it always scans the whole repository checkout
(every `.md` file, minus build artifacts and caches) starting from this
script's own location. Exit status is 0 if every link, anchor, and
document is reachable, or 1 (with one line per problem printed to
stderr) otherwise.
"""

from __future__ import annotations

import argparse
import re
import sys
from collections import Counter, defaultdict
from pathlib import Path
from urllib.parse import unquote

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "dev" / "lib"))
from docslug import anchor_for  # noqa: E402 -- must follow the sys.path insert above

LINK_PATTERN = re.compile(r"!?\[[^\]]*]\(([^)]+)\)")
HEADING_PATTERN = re.compile(r"^(#{1,6})\s+(.+?)\s*#?\s*$")
HTML_ID_PATTERN = re.compile(r'<a\s+id="([^"]+)"></a>')


def anchors_for(path: Path) -> set[str]:
    """Return all heading anchors, including duplicate suffixes."""
    text = path.read_text(encoding="utf-8")
    anchors: set[str] = set(HTML_ID_PATTERN.findall(text))
    counts: Counter[str] = Counter()
    for line in text.splitlines():
        match = HEADING_PATTERN.match(line)
        if match is None:
            continue
        base = anchor_for(match.group(2))
        duplicate = counts[base]
        anchors.add(base if duplicate == 0 else f"{base}-{duplicate}")
        counts[base] += 1
    return anchors


def markdown_files() -> tuple[Path, ...]:
    """Return tracked documentation candidates outside ignored work areas."""
    ignored = {
        ".attic",
        ".git",
        ".mypy_cache",
        ".pytest_cache",
        ".ruff_cache",
        ".tox",
        "build",
        "dist",
        "htmlcov",
        "site",
    }
    # doc/dev/ is scratch/review material, declared out of scope by its own
    # doc/.gitignore ("dev") rather than by name here — a bare "dev" entry
    # in `ignored` above would incorrectly also exclude the real, wanted
    # dev/git-hooks/README.md at the repository root.
    doc_dev = ROOT / "doc" / "dev"
    return tuple(
        sorted(
            path
            for path in ROOT.rglob("*.md")
            if not any(part in ignored for part in path.parts)
            and not any(part.startswith(".venv") for part in path.parts)
            and doc_dev not in path.parents
        )
    )


def validate() -> list[str]:
    """Return every local link, fragment, and orphan error."""
    files = markdown_files()
    file_set = {path.resolve() for path in files}
    anchor_cache = {path.resolve(): anchors_for(path) for path in files}
    inbound: defaultdict[Path, int] = defaultdict(int)
    errors: list[str] = []

    for source in files:
        text = source.read_text(encoding="utf-8")
        for raw_target in LINK_PATTERN.findall(text):
            target = raw_target.strip().split(maxsplit=1)[0].strip("<>")
            if target.startswith(("http://", "https://", "mailto:")):
                continue
            path_part, separator, fragment = target.partition("#")
            destination = (
                source.resolve()
                if not path_part
                else (source.parent / unquote(path_part)).resolve()
            )
            if not destination.exists():
                errors.append(f"{source.relative_to(ROOT)}: missing target {target}")
                continue
            if destination in file_set and destination != source.resolve():
                inbound[destination] += 1
            if (
                separator
                and destination.suffix.lower() == ".md"
                and unquote(fragment) not in anchor_cache.get(destination, set())
            ):
                errors.append(f"{source.relative_to(ROOT)}: missing anchor {target}")

    exempt = {
        (ROOT / "README.md").resolve(),
        (ROOT / "LICENSE.md").resolve(),
        (ROOT / "CHANGELOG.md").resolve(),
    }
    for path in files:
        resolved = path.resolve()
        if resolved not in exempt and inbound[resolved] == 0:
            errors.append(f"{path.relative_to(ROOT)}: orphan document")
    return errors


def main(argv: list[str] | None = None) -> int:
    """Parse arguments (there are none besides `-h`/`--help`), then validate.

    Args:
        argv: Command-line arguments, excluding the program name. `None`
            (the default, used when run as a script) tells `argparse` to
            read `sys.argv[1:]` itself; a real list is used by tests that
            want to drive `main` in-process instead of via a subprocess.

    Returns:
        0 if every link, anchor, and document is reachable; 1 otherwise.
    """
    # This script takes no real options -- `ArgumentParser` is used only
    # so `-h`/`--help` prints the full module docstring above (`argparse`
    # shows `description=` verbatim) instead of the argparse-default
    # bare usage line, and so passing any unexpected argument fails with
    # a clear "unrecognized arguments" error instead of being silently
    # ignored.
    parser = argparse.ArgumentParser(
        prog="check-doc-links",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.parse_args(argv)

    errors = validate()
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1
    print("All local Markdown links, anchors, and documents are connected")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
