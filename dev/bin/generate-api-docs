#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
PATH="${root}/bin:${PATH}"
export PATH
output=${1:-"${root}/src/fim/API.md"}
temporary=$(mktemp "${TMPDIR:-/tmp}/fim-api.XXXXXX")

# Remove the temporary file on every exit.
# Args:
#   None
# Returns:
#   0 after deleting the temporary file
cleanup() {
    rm -f -- "${temporary}"
}
trap cleanup EXIT

{
    printf '%s\n\n' "# \`fim\` API reference"
    printf 'Generated from source docstrings. Do not edit this file directly.\n\n'
    printf 'Return to the [source-tree orientation](../README.md) or the '
    printf '[developer guide](../../doc/developer.md).\n\n'
    cd -- "${root}"
    pydoc-markdown -q -I src -p fim --render-toc \
        | sed 's/[[:blank:]]*$//'
} >"${temporary}"

mkdir -p -- "$(dirname -- "${output}")"
mv -- "${temporary}" "${output}"
trap - EXIT
