#!/usr/bin/env bash
#
# Regenerate `src/fim/API.md`, the committed reference listing every
# public module, class, and function in the `fim` package together with
# its docstring, from the docstrings actually written in `src/fim/` --
# never hand-edit the generated file itself. Run `--help` for the full
# explanation of what this is for and when to run it.

set -o errexit
set -o nounset
set -o pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage: dev/bin/generate-api-docs [OUTPUT_PATH]

Generate `src/fim/API.md` from public module, class, and function
docstrings. Update source docstrings rather than editing the generated
reference. Pre-commit and CI check that the reference is current.

Arguments:
  OUTPUT_PATH   Where to write the generated Markdown file.
                Default: src/fim/API.md (the file committed to
                the repository).

Options:
  -h, --help    Show this help message and exit.
EOF
    exit 0
fi

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
PATH="${root}/bin:${PATH}"
export PATH
output=${1:-"${root}/src/fim/API.md"}
# `pydoc-markdown` writes to this temporary path first, not straight to
# `${output}`, so an interrupted or failing run (a real crash, or a
# `Ctrl-C`) never leaves the committed API reference half-written --
# `mv` below only replaces `${output}` once generation has fully
# succeeded, and the `trap`/`cleanup` pairing further down removes the
# temporary file on any *other* exit path (an error before that `mv`
# is reached).
temporary=$(mktemp "${TMPDIR:-/tmp}/fim-api.XXXXXX")
module_args=()

# `pydoc-markdown` needs to be told exactly which modules to document
# (its own `-m module.name` flag, once per module) -- it does not walk
# a package directory on its own. Building that list here, from the
# real files on disk, rather than hard-coding it, means a newly added
# source file is picked up automatically the next time this script
# runs, with nothing else to remember to update. Not using Python's own
# recursive package-discovery instead because that discovery step
# behaves differently between an editable pip install on macOS and one
# on Linux (confirmed by a real, cross-platform difference this project
# hit before this explicit-list approach was adopted) -- reading the
# file list directly off disk sidesteps that platform difference
# entirely.
while IFS= read -r path; do
    # Turn a file path like ".../src/fim/model/params.py" into the
    # dotted module name "fim.model.params" `pydoc-markdown` expects:
    # strip the "src/" prefix pydoc-markdown never wants to see, drop
    # the ".py" extension, replace path separators with dots, and (for
    # a package's own `__init__.py`) drop the trailing ".__init__" so
    # the package itself is named, not a fake submodule of it.
    module=${path#"${root}/src/"}
    module=${module%.py}
    module=${module//\//.}
    module=${module%.__init__}
    module_args[${#module_args[@]}]=-m
    module_args[${#module_args[@]}]="${module}"
done < <(find "${root}/src/fim" -type f -name '*.py' -print | LC_ALL=C sort)

# Remove the temporary file on every exit.
# Args:
#   None
# Returns:
#   0 after deleting the temporary file
cleanup() {
    rm -f -- "${temporary}"
}
trap cleanup EXIT

{
    printf '%s\n\n' "# \`fim\` API reference"
    printf 'Generated from source docstrings. Do not edit this file directly.\n\n'
    printf 'Return to the [source-tree orientation](../README.md) or the '
    printf '[developer guide](../../doc/developer.md).\n\n'
    cd -- "${root}"
    pydoc-markdown -q -I src "${module_args[@]}" --render-toc \
        | sed 's/[[:blank:]]*$//'
} >"${temporary}"

mkdir -p -- "$(dirname -- "${output}")"
mv -- "${temporary}" "${output}"
trap - EXIT
