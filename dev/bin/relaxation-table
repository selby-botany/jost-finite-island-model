#!/usr/bin/env python3
"""Print the relaxation-time table used in the convergence design, Appendix A.5.

For each reference configuration this compares three estimates of the time
`tau` a run needs to forget its starting state:

- the true value, from the slowest mode of the identity recursion
  (`fim.convergence.defaults.recursion_relaxation_time`),
- the closed form for the symmetric island model, and
- the migration matrix's spectral gap alone, `1 / gap`, which the design
  rejects because it ignores the time two gene copies need to meet.

The unit tests in `test/convergence/test_defaults.py` re-run the island
cases and fail if the closed form drifts from the recursion by more than 5%,
so the design appendix cannot silently disagree with the code.

Usage: dev/bin/relaxation-table
"""

from __future__ import annotations

import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from fim.convergence.defaults import (
    island_relaxation_time,
    recursion_relaxation_time,
)


def island_matrix(d: int, m: float) -> np.ndarray:
    """Return the symmetric island migration matrix."""
    matrix = np.full((d, d), m / (d - 1))
    np.fill_diagonal(matrix, 1.0 - m)
    return matrix


def ring_matrix(d: int, m: float) -> np.ndarray:
    """Return a ring (nearest-neighbor) migration matrix."""
    matrix = np.zeros((d, d))
    for i in range(d):
        matrix[i, i] = 1.0 - m
        matrix[i, (i + 1) % d] += m / 2.0
        matrix[i, (i - 1) % d] += m / 2.0
    return matrix


NONZERO_EIGENVALUE = 1e-12


def spectral_gap(matrix: np.ndarray) -> float:
    """Return the smallest nonzero eigenvalue of `I - M`."""
    eigenvalues = np.sort(np.real(np.linalg.eigvals(np.eye(len(matrix)) - matrix)))
    return float(eigenvalues[eigenvalues > NONZERO_EIGENVALUE][0])


CASES = (
    ("island d=5 N=100 m=1e-4 mu=1e-6", "island", 5, 100, 1e-4, 1e-6),
    ("island d=20 N=100 m=1e-3 mu=1e-6", "island", 20, 100, 1e-3, 1e-6),
    ("island d=4 N=100 m=.01 mu=.005 (Part VI)", "island", 4, 100, 0.01, 0.005),
    ("island d=24 N=2000 m=.01 mu=.001", "island", 24, 2000, 0.01, 0.001),
    ("ring d=10 N=100 m=.01 mu=1e-6", "ring", 10, 100, 0.01, 1e-6),
    ("ring d=20 N=100 m=.01 mu=1e-6", "ring", 20, 100, 0.01, 1e-6),
)


def main() -> None:
    """Print one row per reference configuration."""
    print(f"{'case':44} {'true':>9} {'closed':>9} {'1/gap':>9}")
    for label, kind, d, n, m, mu in CASES:
        matrix = island_matrix(d, m) if kind == "island" else ring_matrix(d, m)
        true = recursion_relaxation_time(
            deme_sizes=[n] * d, migration=matrix.tolist(), mutation=mu
        )
        closed = f"{'n/a':>9}"
        if kind == "island":
            estimate = island_relaxation_time(
                total_size=d * n, deme_count=d, migration=m, mutation=mu
            )
            closed = f"{estimate:9.0f}"
        print(f"{label:44} {true:9.0f} {closed} {1.0 / spectral_gap(matrix):9.0f}")


if __name__ == "__main__":
    main()
