#!/usr/bin/env python3
"""Characterize the per-replicate spread behind the equilibrium test bands.

`test/validation/test_simulator_equilibrium.py` asserts four engine-level
scientific tests (Part VI equilibrium, Dear-Nolan low migration, Dear-Nolan
high migration, and the Crow & Aoki (1984) toroidal stepping-stone
scenario) against a band of the form ``k * sigma / sqrt(replicates)``,
where ``sigma`` is a per-replicate standard deviation. Deriving that
``sigma`` analytically would require propagating variance through a
multi-generation Migrate -> Mutate -> Drift recursion's higher moments (a
delta-method expansion of a ratio-of-means statistic sampled from nested
binomial/multinomial draws) -- not currently derived, and out of scope for
this program; see the "Analytic bound" note in this script's report output.
Absent that, the bands are set from an *empirical characterization pass*:
run each scenario's exact configuration many times (many more replicates
than the assertion test itself uses) with a seed range distinct from the
assertion test's own seed, and take the sample standard deviation of the
per-replicate ``G_ST``/``D`` estimates.

This was previously done ad hoc -- an unretained, unversioned pass whose
program, seeds, raw output, and environment were never recorded (R18,
`doc/dev/20260818-claude-opus-5-project-review-rollup.md`, not committed --
gitignored review material). This script versions that program; running it
and committing its `--output` alongside a `CHANGELOG.md` entry versions the
evidence.

Deliberately NOT wired into `build` or `ci.yml`: this is a maintainer tool
run manually, on demand, when a scenario's configuration changes enough
that its previously characterized `_SIGMA_*` constants might no longer be
a conservative bound -- not a step in the deterministic PR gate, which
must stay a pure function of the commit (CLAUDE.md). A characterization
pass is itself stochastic by design (that is the thing it measures); its
raw output is retained precisely so a future maintainer never has to take
today's numbers on faith.

Usage:
    dev/bin/calibrate-statistical-bands \\
        --replicates-part-vi 30 --replicates-dear-nolan-low 40 \\
        --replicates-dear-nolan-high 20 --replicates-crow-aoki-torus 10 \\
        --output test/validation/statistical-calibration-evidence.json
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import math
import platform
import statistics
import sys
import time
from dataclasses import dataclass
from datetime import UTC, datetime
from importlib.metadata import version as installed_version
from pathlib import Path
from types import ModuleType

ROOT = Path(__file__).resolve().parents[2]
SCENARIO_MODULE_PATH = ROOT / "test" / "validation" / "test_simulator_equilibrium.py"
DEFAULT_OUTPUT_PATH = (
    ROOT / "test" / "validation" / "statistical-calibration-evidence.json"
)

# Characterization seeds are disjoint from every assertion test's own seed
# (707000, 884000, 992000) so a characterization run can never coincide with,
# or be mistaken for, the specific realization an assertion test asserts
# against.
_DEFAULT_SEED_PART_VI = 600000
_DEFAULT_SEED_DEAR_NOLAN_LOW = 601000
_DEFAULT_SEED_DEAR_NOLAN_HIGH = 602000
_DEFAULT_SEED_CROW_AOKI_TORUS = 603000
_DEFAULT_SEED_CHAO_SHANNON = 604000


@dataclass(frozen=True)
class CharacterizationResult:
    """One scenario's empirical per-replicate spread."""

    name: str
    seed: int
    replicates: int
    elapsed_seconds: float
    g_values: tuple[float, ...]
    d_values: tuple[float, ...]

    @property
    def sigma_g(self) -> float:
        """Sample standard deviation of the per-replicate `G_ST` draws."""
        return statistics.stdev(self.g_values)

    @property
    def sigma_d(self) -> float:
        """Sample standard deviation of the per-replicate `D` draws."""
        return statistics.stdev(self.d_values)


def _load_scenario_module() -> ModuleType:
    """Import `test_simulator_equilibrium.py` by file path.

    Loaded directly from its path -- not `import test.validation....` --
    so this script runs standalone, without pytest's rootdir-based
    `sys.path` setup, and is guaranteed to run the *exact* scenario
    construction the assertion tests use rather than a hand-copied,
    driftable duplicate of it.

    Returns:
        The loaded module, exposing `_run_engine_pooled`,
        `_identity_fixed_point`, `_dn1_equilibrium_start`, and
        `_dn2_equilibrium_start`.
    """
    spec = importlib.util.spec_from_file_location(
        "fim_equilibrium_test_scenarios", SCENARIO_MODULE_PATH
    )
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load test module at {SCENARIO_MODULE_PATH}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def _characterize_part_vi(
    module: ModuleType, *, seed: int, replicates: int
) -> CharacterizationResult:
    """Characterize the moderate-migration Part VI scenario.

    Same configuration as `test_engine_reproduces_part_vi_equilibrium`
    (`N=100, m=0.01, mu=0.005, d=4`, 8 loci, horizon 1000).
    """
    started = time.monotonic()
    g_values, d_values = module._run_engine_pooled(
        population_size=100,
        m=0.01,
        mu=0.005,
        d=4,
        n_loci=8,
        horizon=1000,
        replicates=replicates,
        seed=seed,
    )
    elapsed = time.monotonic() - started
    return CharacterizationResult(
        "part_vi", seed, replicates, elapsed, tuple(g_values), tuple(d_values)
    )


def _characterize_dear_nolan_low(
    module: ModuleType, *, seed: int, replicates: int
) -> CharacterizationResult:
    """Characterize the low-migration Dear-Nolan scenario.

    Same configuration as `test_dear_nolan_low_migration_scenario_via_engine`
    (`N=100, d=5, m=0.0001, mu=0.000001`, derived multi-locus equilibrium
    start, horizon 100).
    """
    d = 5
    within_star, between_star = module._identity_fixed_point(
        population_size=100, m=0.0001, mu=0.000001, d=d
    )
    equilibrium_start = module._dn1_equilibrium_start(
        within_fixed_point=within_star, between_fixed_point=between_star, d=d
    )
    n_loci = len(equilibrium_start[0])
    started = time.monotonic()
    g_values, d_values = module._run_engine_pooled(
        population_size=100,
        m=0.0001,
        mu=0.000001,
        d=d,
        n_loci=n_loci,
        horizon=100,
        replicates=replicates,
        seed=seed,
        initial_frequencies=equilibrium_start,
    )
    elapsed = time.monotonic() - started
    return CharacterizationResult(
        "dear_nolan_low", seed, replicates, elapsed, tuple(g_values), tuple(d_values)
    )


def _characterize_dear_nolan_high(
    module: ModuleType, *, seed: int, replicates: int
) -> CharacterizationResult:
    """Characterize the high-migration Dear-Nolan scenario.

    Same configuration as
    `test_dear_nolan_high_migration_scenario_via_engine` (`N=2000, d=100,
    m=0.01, mu=0.001`, derived near-equilibrium single-locus start,
    horizon 30).
    """
    d = 100
    within_star, between_star = module._identity_fixed_point(
        population_size=2000, m=0.01, mu=0.001, d=d
    )
    equilibrium_start = module._dn2_equilibrium_start(
        within_fixed_point=within_star,
        between_fixed_point=between_star,
        d=d,
        shared_count=41,
    )
    started = time.monotonic()
    g_values, d_values = module._run_engine_pooled(
        population_size=2000,
        m=0.01,
        mu=0.001,
        d=d,
        n_loci=1,
        horizon=30,
        replicates=replicates,
        seed=seed,
        initial_frequencies=equilibrium_start,
    )
    elapsed = time.monotonic() - started
    return CharacterizationResult(
        "dear_nolan_high", seed, replicates, elapsed, tuple(g_values), tuple(d_values)
    )


def _characterize_crow_aoki_torus(
    module: ModuleType, *, seed: int, replicates: int
) -> CharacterizationResult:
    """Characterize the Crow & Aoki (1984) toroidal stepping-stone scenario.

    Same configuration as `test_crow_aoki_torus_scenario_via_engine`
    (a 3-by-3 torus, `N=20, mu=1e-5, m=0.05`, 150 loci, horizon 6000 --
    see that test's own docstring for the empirical search that found
    this specific configuration; 100 loci / horizon 2000 was tried first
    and found to converge too slowly). Unlike the three scenarios above,
    this one has no independent exact-recursion oracle (see that test's
    own docstring for why) -- the characterization pass still measures
    the same thing, the empirical per-replicate spread of the engine's
    own pooled `G_ST`/`D`, it is just compared against the literal
    published number directly rather than against an oracle too. Each
    replicate costs around 225 seconds (versus, e.g., Dear-Nolan-high's
    much cheaper 1-locus/30-generation replicates), so this
    characterization pass deliberately defaults to fewer replicates than
    the other three scenarios' own 20-100.
    """
    started = time.monotonic()
    g_values, d_values = module._run_engine_pooled(
        population_size=20,
        m=module._crow_aoki_torus_matrix(3, 0.05),
        mu=1e-5,
        d=9,
        n_loci=150,
        horizon=6000,
        replicates=replicates,
        seed=seed,
    )
    elapsed = time.monotonic() - started
    return CharacterizationResult(
        "crow_aoki_torus", seed, replicates, elapsed, tuple(g_values), tuple(d_values)
    )


def _characterize_chao_shannon_equilibrium(
    module: ModuleType, *, seed: int, replicates: int
) -> dict[str, object]:
    """Characterize the Chao et al. (2015) Shannon-equilibrium scenario.

    Reuses Part VI's own already-proven-convergent `(N, m, mu, d)`
    (`N=100, m=0.01, mu=0.005, d=4`) rather than searching for a new
    configuration from scratch, at a longer horizon (2000 generations,
    versus Part VI's own 1000) -- deliberately, not arbitrarily: Chao et
    al. (2015) state directly, in their own Discussion, that
    "the measure GST in FIM converges very quickly ... whereas the
    normalized mutual information based on Shannon entropy converges
    relatively slowly," so the exact horizon already proven to converge
    `G_ST`/`D` in `test_engine_reproduces_part_vi_equilibrium` is not
    assumed to also be enough for Shannon differentiation, and was not:
    a quick single-seed check across horizons 1000-8000 (this session's
    own record, not repeated here) found `G_ST`-style convergence
    already essentially flat by 1000 but the Shannon-based statistics
    still measurably settling at that horizon.

    Three named statistics (`H_T`, `H_S`, Shannon differentiation), not
    the two (`G_ST`, `D`) `CharacterizationResult`/`_render_data` above
    are built for -- returns a plain dict in its own natural schema
    rather than forcing a fit into that one, and is merged into the
    same output payload's own `scenarios` mapping directly in `main`,
    below, rather than through `_render_data`. Generalizing
    `CharacterizationResult` to an arbitrary number of named series
    would remove this asymmetry; not done here to avoid touching the
    four already-working, already-validated G_ST/D scenarios' own code
    path for a fifth scenario's sake.
    """
    started = time.monotonic()
    total_values, subpopulation_values, differentiation_values = (
        module._run_engine_pooled_shannon(
            population_size=100,
            m=0.01,
            mu=0.005,
            d=4,
            n_loci=8,
            horizon=2000,
            replicates=replicates,
            seed=seed,
        )
    )
    elapsed = time.monotonic() - started

    def _stats(values: list[float]) -> dict[str, float]:
        mean = statistics.fmean(values)
        sigma = statistics.stdev(values)
        return {
            "mean": mean,
            "empirical_sigma": sigma,
            "recommended_sigma": _recommend_sigma(sigma),
        }

    return {
        "seed": seed,
        "replicates": replicates,
        "elapsed_seconds": elapsed,
        "total_entropy": {**_stats(total_values), "values": total_values},
        "subpopulation_entropy": {
            **_stats(subpopulation_values),
            "values": subpopulation_values,
        },
        "shannon_differentiation": {
            **_stats(differentiation_values),
            "values": differentiation_values,
        },
    }


def _environment_fingerprint() -> dict[str, str]:
    """Return the interpreter/platform/package versions this run used."""
    fingerprint = {
        "python_version": platform.python_version(),
        "platform": platform.platform(),
        "machine": platform.machine(),
    }
    for package in ("numpy", "matplotlib"):
        try:
            fingerprint[f"{package}_version"] = installed_version(package)
        except Exception:  # best-effort: an environment fingerprint, not a gate
            fingerprint[f"{package}_version"] = "unknown"
    return fingerprint


def _recommend_sigma(sigma: float) -> float:
    """Round a characterized sigma up to a conservative, human-set constant.

    Rounds up to two significant figures and adds ~20% headroom, matching
    the "rounded up" practice the assertion test's own comments already
    described before this script existed -- codified here rather than
    left to be re-derived by hand each time.
    """
    if sigma <= 0.0:
        return 0.0
    magnitude = 10.0 ** math.floor(math.log10(sigma))
    padded = sigma * 1.2
    return math.ceil(padded / magnitude * 100.0) / 100.0 * magnitude


def _load_existing_assertion_sigmas(
    output_path: Path,
) -> dict[str, tuple[float, float]]:
    """Load previously committed assertion sigma values, if present."""
    if not output_path.is_file():
        return {}
    try:
        existing = json.loads(output_path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    scenarios = existing.get("scenarios", {})
    loaded: dict[str, tuple[float, float]] = {}
    for scenario_name, scenario_data in scenarios.items():
        if not isinstance(scenario_data, dict):
            continue
        sigma_g = scenario_data.get("assertion_sigma_g")
        sigma_d = scenario_data.get("assertion_sigma_d")
        if isinstance(sigma_g, (int, float)) and isinstance(sigma_d, (int, float)):
            loaded[scenario_name] = (float(sigma_g), float(sigma_d))
    return loaded


def _render_data(
    results: list[CharacterizationResult],
    fingerprint: dict[str, str],
    existing_sigmas: dict[str, tuple[float, float]],
) -> dict[str, object]:
    """Render the full machine-readable characterization payload."""
    scenarios: dict[str, dict[str, object]] = {}
    for result in results:
        recommended_g = _recommend_sigma(result.sigma_g)
        recommended_d = _recommend_sigma(result.sigma_d)
        previous_g, previous_d = existing_sigmas.get(result.name, (0.0, 0.0))
        assertion_g = previous_g if previous_g > 0.0 else recommended_g
        assertion_d = previous_d if previous_d > 0.0 else recommended_d
        scenarios[result.name] = {
            "seed": result.seed,
            "replicates": result.replicates,
            "elapsed_seconds": result.elapsed_seconds,
            "mean_g_st": statistics.fmean(result.g_values),
            "mean_d": statistics.fmean(result.d_values),
            "empirical_sigma_g": result.sigma_g,
            "empirical_sigma_d": result.sigma_d,
            "recommended_sigma_g": recommended_g,
            "recommended_sigma_d": recommended_d,
            "assertion_sigma_g": assertion_g,
            "assertion_sigma_d": assertion_d,
            "g_st_values": list(result.g_values),
            "d_values": list(result.d_values),
        }
    return {
        "schema_version": 1,
        "generator": {
            "name": "Claude Code",
            "version": "Claude Sonnet 5",
            "model_token": "claude-sonnet-5",
            "provider": "Anthropic",
            "generation_date": datetime.now(UTC).date().isoformat(),
            "responsibility": "other",
            "script": "dev/bin/calibrate-statistical-bands",
        },
        "fim_version": (ROOT / "version.txt").read_text(encoding="utf-8").strip(),
        "environment": fingerprint,
        "analytic_bound_note": (
            "Not currently available. The per-replicate G_ST/D estimate is a "
            "ratio-of-means statistic over heterozygosities sampled from a "
            "multi-generation Migrate -> Mutate -> Drift recursion; a "
            "closed-form variance would need delta-method propagation through "
            "that recursion's higher moments, which has not been derived."
        ),
        "scenarios": scenarios,
    }


def main(argv: list[str] | None = None) -> int:
    """Run every scenario's characterization pass and write the report."""
    # `RawDescriptionHelpFormatter` preserves the module docstring's own
    # paragraph breaks in `--help` output -- without it, argparse
    # re-wraps the whole docstring into one dense paragraph, losing the
    # separation between "what this measures," "why it exists," and
    # "why it is not part of the automated gate."
    parser = argparse.ArgumentParser(
        prog="calibrate-statistical-bands",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--replicates-part-vi", type=int, default=30, help="default: 30"
    )
    parser.add_argument(
        "--replicates-dear-nolan-low", type=int, default=40, help="default: 40"
    )
    parser.add_argument(
        "--replicates-dear-nolan-high", type=int, default=20, help="default: 20"
    )
    parser.add_argument(
        "--replicates-crow-aoki-torus", type=int, default=10, help="default: 10"
    )
    parser.add_argument(
        "--replicates-chao-shannon", type=int, default=10, help="default: 10"
    )
    parser.add_argument("--seed-part-vi", type=int, default=_DEFAULT_SEED_PART_VI)
    parser.add_argument(
        "--seed-dear-nolan-low", type=int, default=_DEFAULT_SEED_DEAR_NOLAN_LOW
    )
    parser.add_argument(
        "--seed-dear-nolan-high", type=int, default=_DEFAULT_SEED_DEAR_NOLAN_HIGH
    )
    parser.add_argument(
        "--seed-crow-aoki-torus", type=int, default=_DEFAULT_SEED_CROW_AOKI_TORUS
    )
    parser.add_argument(
        "--seed-chao-shannon", type=int, default=_DEFAULT_SEED_CHAO_SHANNON
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=DEFAULT_OUTPUT_PATH,
        help=(
            "write the JSON report here "
            "(default: test/validation/statistical-calibration-evidence.json)"
        ),
    )
    args = parser.parse_args(argv)

    module = _load_scenario_module()
    results = [
        _characterize_part_vi(
            module, seed=args.seed_part_vi, replicates=args.replicates_part_vi
        ),
        _characterize_dear_nolan_low(
            module,
            seed=args.seed_dear_nolan_low,
            replicates=args.replicates_dear_nolan_low,
        ),
        _characterize_dear_nolan_high(
            module,
            seed=args.seed_dear_nolan_high,
            replicates=args.replicates_dear_nolan_high,
        ),
        _characterize_crow_aoki_torus(
            module,
            seed=args.seed_crow_aoki_torus,
            replicates=args.replicates_crow_aoki_torus,
        ),
    ]
    existing_sigmas = _load_existing_assertion_sigmas(args.output)
    payload = _render_data(results, _environment_fingerprint(), existing_sigmas)
    # `chao_shannon_equilibrium` has its own three-named-statistic schema
    # (see `_characterize_chao_shannon_equilibrium`'s own docstring for
    # why it is not built from `CharacterizationResult`/`_render_data`
    # like the four scenarios above) -- merged in directly rather than
    # forced through that G_ST/D-shaped rendering path.
    payload["scenarios"]["chao_shannon_equilibrium"] = (  # type: ignore[index]
        _characterize_chao_shannon_equilibrium(
            module,
            seed=args.seed_chao_shannon,
            replicates=args.replicates_chao_shannon,
        )
    )
    args.output.write_text(
        json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    print(f"calibrate-statistical-bands: wrote {args.output}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
