#!/usr/bin/env python3
"""Compare simulated trajectories with the independent hierfstat simulator.

Runs a matching scenario in hierfstat, converts its raw population genotypes
to allele frequencies, and computes this project's statistics for comparison.
The command reports measurements but does not pass or fail a tolerance test;
no comparison tolerance has been calibrated. It is a manual maintainer tool
that requires the hierfstat Docker image.
"""

from __future__ import annotations

import argparse
import csv
import io
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "src"))

from fim.statistics import equilibrium_d, equilibrium_g_st, g_st, h_s, h_t, jost_d

_DOCKER_CONTEXT = Path(__file__).resolve().parents[1] / "docker" / "hierfstat"
_IMAGE_TAG = "fim-hierfstat-compare:dev"


def _build_image() -> None:
    """Build (or reuse, via Docker's own layer cache) the comparison image."""
    subprocess.run(
        ["docker", "build", "--tag", _IMAGE_TAG, str(_DOCKER_CONTEXT)],
        check=True,
    )


def _run_simulation(
    *,
    n_diploid: int,
    m: float,
    mu: float,
    d: int,
    generations: int,
    nbal: int,
    nbloc: int,
    seed: int,
) -> str:
    """Run the R container and return its raw CSV genotype output."""
    result = subprocess.run(
        [
            "docker",
            "run",
            "--rm",
            _IMAGE_TAG,
            str(n_diploid),
            str(m),
            str(mu),
            str(d),
            str(generations),
            str(nbal),
            str(nbloc),
            str(seed),
        ],
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout


def _genotype_to_alleles(cell: str, allele_width: int) -> tuple[int, int] | None:
    """Split one hierfstat genotype cell into its two allele codes.

    hierfstat's own genepop-style convention (confirmed against `mmod`'s
    bundled `test.gen` fixture while researching this tool): each locus
    cell is two fixed-width allele codes concatenated together, `NA` for
    a missing genotype. The per-allele width is *not* safe to derive from
    the cell's own length -- confirmed the hard way running a real scenario
    this session, where a genotype pair with a low-numbered leading allele
    (e.g. allele ``4`` under a two-digit ``nbal=99`` scheme) came back as
    the numeral ``404`` rather than the fixed-width ``"0404"``, because
    hierfstat's own CSV column stores genotypes as a plain integer, which
    has no leading zero to begin with. The caller passes `allele_width`
    (derived from the run's own ``nbal`` argument, the one thing that
    actually fixes the width) and every cell is left-zero-padded to
    ``2 * allele_width`` before splitting, recovering the dropped digit.
    """
    text = str(cell).strip()
    if not text or text.upper() == "NA":
        return None
    padded = text.zfill(2 * allele_width)
    return int(padded[:allele_width]), int(padded[allele_width:])


def _frequency_table_from_genotypes(
    rows: list[dict[str, str]],
    locus_column: str,
    deme_count: int,
    allele_width: int,
) -> list[dict[int, float]]:
    """Build one locus's `FrequencyTable` from hierfstat's raw genotype rows.

    Each simulated individual contributes two gene copies (diploid) to its
    own population's allele counts; the result is normalized to
    frequencies, matching `fim.statistics`'s own `FrequencyTable` contract
    exactly -- this is this project's own exact allele-frequency
    accounting applied to hierfstat's own simulated individuals, not
    anything hierfstat itself computes.
    """
    counts: list[dict[int, int]] = [{} for _ in range(deme_count)]
    for row in rows:
        deme_index = int(row["Pop"]) - 1
        alleles = _genotype_to_alleles(row[locus_column], allele_width)
        if alleles is None:
            continue
        for allele in alleles:
            counts[deme_index][allele] = counts[deme_index].get(allele, 0) + 1
    table: list[dict[int, float]] = []
    for deme_counts in counts:
        total = sum(deme_counts.values())
        table.append({allele: count / total for allele, count in deme_counts.items()})
    return table


def _report(
    *,
    population_size: int,
    m: float,
    mu: float,
    d: int,
    nbal: int,
    csv_text: str,
) -> None:
    """Print a comparison: hierfstat's own simulated statistics vs. this
    project's closed-form equilibrium prediction, at matched parameters."""
    rows = list(csv.DictReader(io.StringIO(csv_text)))
    locus_columns = [name for name in rows[0] if name != "Pop"]
    allele_width = len(str(nbal))

    h_s_values: list[float] = []
    h_t_values: list[float] = []
    g_st_values: list[float] = []
    d_values: list[float] = []
    for locus_column in locus_columns:
        table = _frequency_table_from_genotypes(rows, locus_column, d, allele_width)
        h_s_values.append(h_s(table))
        h_t_values.append(h_t(table))
        locus_g_st = g_st(table)
        if locus_g_st is not None:
            g_st_values.append(locus_g_st)
        d_values.append(jost_d(table))

    mean_h_s = sum(h_s_values) / len(h_s_values)
    mean_h_t = sum(h_t_values) / len(h_t_values)
    mean_g_st = sum(g_st_values) / len(g_st_values)
    mean_d = sum(d_values) / len(d_values)

    theoretical_g_st = equilibrium_g_st(population_size, m, mu, d)
    theoretical_d = equilibrium_d(m, mu, d)

    print(f"loci: {len(locus_columns)}")
    print(
        f"hierfstat  H_S={mean_h_s:.4f}  H_T={mean_h_t:.4f}  "
        f"G_ST={mean_g_st:.4f}  D={mean_d:.4f}"
    )
    print(f"theory     G_ST={theoretical_g_st:.4f}  D={theoretical_d:.4f}")


def main(argv: list[str] | None = None) -> int:
    """Build the comparison image, run one scenario, and print the report."""
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--population-size",
        type=int,
        default=100,
        help="gene copies; must be even (default: 100)",
    )
    parser.add_argument("--m", type=float, default=0.01, help="default: 0.01")
    parser.add_argument("--mu", type=float, default=0.005, help="default: 0.005")
    parser.add_argument("--d", type=int, default=4, help="default: 4")
    parser.add_argument("--generations", type=int, default=4000, help="default: 4000")
    parser.add_argument(
        "--nbal", type=int, default=99, help="max alleles per locus (default: 99)"
    )
    parser.add_argument("--nbloc", type=int, default=200, help="default: 200")
    parser.add_argument("--seed", type=int, default=900001, help="default: 900001")
    parser.add_argument(
        "--skip-build",
        action="store_true",
        help="reuse the already-built Docker image instead of rebuilding it",
    )
    args = parser.parse_args(argv)

    if args.population_size % 2 != 0:
        parser.error("--population-size must be even (2 * diploid individuals)")
    n_diploid = args.population_size // 2

    if not args.skip_build:
        _build_image()

    csv_text = _run_simulation(
        n_diploid=n_diploid,
        m=args.m,
        mu=args.mu,
        d=args.d,
        generations=args.generations,
        nbal=args.nbal,
        nbloc=args.nbloc,
        seed=args.seed,
    )
    _report(
        population_size=args.population_size,
        m=args.m,
        mu=args.mu,
        d=args.d,
        nbal=args.nbal,
        csv_text=csv_text,
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
