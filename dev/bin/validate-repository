#!/usr/bin/env bash
#
# Run every repository-hygiene checker this project uses, over the whole
# checkout. Run `--help` for the full explanation of what this is for.

set -o errexit
set -o nounset
set -o pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage: dev/bin/validate-repository

Run every repository-hygiene checker this project uses, over the whole
checkout:

  - shellcheck    every shell script this project ships, for real bugs
                  (not just style) -- an unquoted variable that breaks on
                  a space, a typo'd flag, a comparison that silently
                  never matches.
  - yamllint      the GitHub Actions workflow files and Dependabot
                  config, for syntax and structural mistakes YAML's own
                  permissive parsing would otherwise let through
                  silently (a workflow that "parses" but never runs the
                  step you meant it to).
  - markdownlint  every Markdown file in the repository, for consistent,
                  correctly structured formatting (heading levels that
                  skip a level, an unclosed code fence, and so on).
  - gitleaks      a scan of the entire repository for text that looks
                  like a credential, API key, or password -- something
                  that must never be committed, checked here rather
                  than trusted to memory.

Why this exists:
  These checks catch a different class of mistake than the test suite --
  a broken shell script, a malformed YAML workflow file, an inconsistent
  Markdown heading, or a leaked API key or password -- before it reaches
  a reviewer or a released package. This matters even for a researcher
  who never expects to touch a shell script directly: a broken CI
  workflow or a leaked secret affects the safety and reliability of the
  whole project, not just whichever file happened to change.

  None of the four tools above need to be installed on your machine
  directly. Each one is a pinned, Docker-backed wrapper script living in
  this project's own bin/ directory (bin/shellcheck, bin/yamllint,
  bin/markdownlint, bin/gitleaks) -- running the tool actually means
  running a specific, version-locked container image, the same one every
  time, on every machine and in CI alike. That way a result never
  depends on which version of a linter someone happened to have
  installed locally, and a fresh checkout can run this immediately with
  no setup beyond having Docker itself installed and running.

Requires Docker Engine to be running (the wrappers in bin/ pull their
pinned tool images automatically on first use, and reuse them after
that).

Options:
  -h, --help    Show this help message and exit.
EOF
    exit 0
fi

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
cd -- "${root}"
PATH="${root}/bin:${PATH}"
export PATH

# `shellcheck` is given every real `.sh`-style script by explicit path
# here, rather than being pointed at a directory to search recursively:
# this project's own `bin/` wrappers are themselves short shell scripts
# with a `.` or no extension at all (not `.sh`), so a recursive,
# extension-based search would miss most of them, and would also
# wrongly try to lint unrelated text files that merely start with `#!`
# somewhere in a comment. Explicit paths mean a *new* wrapper script
# must be added to this list by hand to be checked -- deliberate, not
# an oversight, since it also serves as the one place a maintainer can
# see every shell script this project actually ships.
shellcheck \
    build \
    bin/fim \
    bin/gitleaks \
    bin/markdownlint \
    bin/mypy \
    bin/pydoc-markdown \
    bin/pyinstaller \
    bin/pytest \
    bin/python-module \
    bin/python3 \
    bin/ruff \
    bin/shellcheck \
    bin/yamllint \
    dev/bin/validate-repository \
    dev/bin/generate-api-docs \
    dev/git-hooks/commit-msg \
    dev/git-hooks/install \
    dev/git-hooks/pre-commit \
    dev/git-hooks/pre-push \
    include/dot-bashrc \
    install/homebrew/test-formula
# The three files GitHub Actions/Dependabot actually read -- every other
# `.yml`/`.yaml` file in the repository (if any ever appears) is not a
# workflow definition and so has no structural rules worth enforcing
# here.
yamllint \
    .github/dependabot.yml \
    .github/workflows/ci.yml \
    .github/workflows/gitleaks-ci.yml
# Every `.md` file (`**/*.md`), except the ones a leading `#` excludes:
# generated/vendored content this tool should never rewrite or complain
# about (`LICENSE.md`, a third-party text; `src/fim/API.md`/`test/
# TESTS.md`, generated by `dev/bin/generate-api-docs`/`generate-
# test-docs` and already covered by their own generators instead), and
# build/cache/scratch directories that hold no real, committed
# documentation at all.
markdownlint \
    "**/*.md" \
    "#.attic/**" \
    "#.mypy_cache/**" \
    "#.pytest_cache/**" \
    "#.ruff_cache/**" \
    "#.venv*/**" \
    "#LICENSE.md" \
    "#build/**" \
    "#dist/**" \
    "#doc/dev/**" \
    "#htmlcov/**" \
    "#site/**" \
    "#src/fim/API.md" \
    "#test/TESTS.md"
# The whole repository, including its full commit history (`gitleaks
# dir` scans the working tree; the separate `.github/workflows/gitleaks-
# ci.yml` job scans history on push) -- `--redact` prints only enough of
# any match to identify it, never the full secret value itself, so a
# false positive shown in this command's own output never becomes a
# second place the same secret is now exposed.
gitleaks dir . --no-banner --redact
