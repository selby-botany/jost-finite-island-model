#!/usr/bin/env bash
#
# Run every repository-hygiene checker this project uses, over the whole
# checkout. Run `--help` for the full explanation of what this is for.

set -o errexit
set -o nounset
set -o pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    cat <<'EOF'
Usage: dev/bin/validate-repository

Run repository-wide checks for shell scripts, YAML, Markdown, GUI
JavaScript, CSS, HTML, and likely secrets. The checks use the wrappers in
`bin/` and require Docker Engine.

`dev/bin/check-webui-assets` separately checks cross-file GUI asset
references and runs as part of `./build`.

Options:
  -h, --help    Show this help message and exit.
EOF
    exit 0
fi

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
cd -- "${root}"
PATH="${root}/bin:${PATH}"
export PATH

# `shellcheck` is given every real `.sh`-style script by explicit path
# here, rather than being pointed at a directory to search recursively:
# this project's own `bin/` wrappers are themselves short shell scripts
# with a `.` or no extension at all (not `.sh`), so a recursive,
# extension-based search would miss most of them, and would also
# wrongly try to lint unrelated text files that merely start with `#!`
# somewhere in a comment. Explicit paths mean a *new* wrapper script
# must be added to this list by hand to be checked -- deliberate, not
# an oversight, since it also serves as the one place a maintainer can
# see every shell script this project actually ships.
shellcheck \
    build \
    bin/eslint \
    bin/fim \
    bin/fim-gui \
    bin/gitleaks \
    bin/htmlhint \
    bin/markdownlint \
    bin/mypy \
    bin/poppler \
    bin/pydoc-markdown \
    bin/pyinstaller \
    bin/pytest \
    bin/python-module \
    bin/python3 \
    bin/ruff \
    bin/shellcheck \
    bin/stylelint \
    bin/yamllint \
    dev/bin/validate-repository \
    dev/bin/generate-api-docs \
    dev/git-hooks/commit-msg \
    dev/git-hooks/install \
    dev/git-hooks/pre-commit \
    dev/git-hooks/pre-push \
    include/dot-bashrc \
    install/homebrew/test-formula
# The three files GitHub Actions/Dependabot actually read -- every other
# `.yml`/`.yaml` file in the repository (if any ever appears) is not a
# workflow definition and so has no structural rules worth enforcing
# here.
yamllint \
    .github/dependabot.yml \
    .github/workflows/ci.yml \
    .github/workflows/gitleaks-ci.yml
# Every `.md` file (`**/*.md`), except the ones a leading `#` excludes:
# generated/vendored content this tool should never rewrite or complain
# about (`LICENSE.md`, a third-party text; `src/fim/API.md`/`test/
# TESTS.md`, generated by `dev/bin/generate-api-docs`/`generate-
# test-docs` and already covered by their own generators instead), and
# build/cache/scratch directories that hold no real, committed
# documentation at all. `.attic/` and `.wip/` are both git-ignored
# scratch space, so nothing in them is committed documentation either.
markdownlint \
    "**/*.md" \
    "#.attic/**" \
    "#.claude/worktrees/**" \
    "#.mypy_cache/**" \
    "#.pytest_cache/**" \
    "#.ruff_cache/**" \
    "#.venv*/**" \
    "#.wip/**" \
    "#LICENSE.md" \
    "#build/**" \
    "#dist/**" \
    "#doc/dev/**" \
    "#htmlcov/**" \
    "#site/**" \
    "#src/fim/API.md" \
    "#test/TESTS.md"
# The desktop GUI's own browser sources. Each tool is pointed at a glob
# rather than a directory because that is the form all three accept, and
# the globs are quoted so the tool expands them inside the container
# rather than the shell expanding them out here.
eslint "src/fim/gui/webui/**/*.js"
stylelint "src/fim/gui/webui/**/*.css"
# `index.html` is a whole document; the files under `help/` are
# generated body fragments with no doctype, no <html>, and no <title>,
# so they are checked against a config that drops those three
# document-level rules and keeps everything else. See the comment at the
# top of `.htmlhintrc-fragment`.
htmlhint src/fim/gui/webui/index.html
htmlhint --config .htmlhintrc-fragment "src/fim/gui/webui/help/*.html"
# Every commit in the repository's own history (`gitleaks git`), which
# is exactly the content that can actually leak: a secret becomes a
# disclosure by being committed and pushed, so committed history is the
# thing worth gating on. The separate `.github/workflows/gitleaks-ci.yml`
# job scans the same way on push.
#
# Deliberately not `gitleaks dir .`, which scans the working tree as
# files on disk and so reads three categories of file that can never
# leak because git will never carry them: git-ignored local
# configuration (`.envrc`, which legitimately holds real tokens on a
# developer's own machine), untracked scratch (`.wip/`, `.attic/`), and
# installed third-party code (`.venv*/`). That made the check both
# noisy and slow -- it reported findings nobody can act on, in files
# that are not part of the project, while scanning ~148MB instead of
# this repository's own ~7.7MB. A check that cries wolf on every
# developer machine is a check that gets skipped.
#
# `--redact` prints only enough of any match to identify it, never the
# full secret value, so a finding shown in this command's own output
# never becomes a second place the same secret is exposed.
gitleaks git . --no-banner --redact
