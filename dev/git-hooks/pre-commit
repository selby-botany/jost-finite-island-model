#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

root=$(git rev-parse --show-toplevel)
cd -- "${root}"
PATH="${root}/bin:${PATH}"
export PATH

if [[ ! -f pyproject.toml ]]; then
    printf 'pre-commit: pyproject.toml absent; Python gates skipped\n'
    exit 0
fi

# Collect staged Python paths without losing whitespace or special characters.
python_files=()
while IFS= read -r -d '' path; do
    [[ "${path}" == *.py ]] && python_files[${#python_files[@]}]="${path}"
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

# Normalize staged Python and refresh its generated API documentation.
if ((${#python_files[@]})); then
    if command -v ruff >/dev/null 2>&1; then
        ruff format -- "${python_files[@]}"
        ruff check --fix -- "${python_files[@]}"
        git add -- "${python_files[@]}"
    else
        printf 'pre-commit: ruff absent; formatting skipped\n'
    fi

    if [[ -x dev/bin/generate-api-docs ]] \
        && command -v pydoc-markdown >/dev/null 2>&1; then
        dev/bin/generate-api-docs
        git add -- src/fim/API.md
    else
        printf 'pre-commit: API generator unavailable; refresh skipped\n'
    fi

    # `test/TESTS.md` is `src/fim/API.md`'s test-suite counterpart
    # (`dev/bin/generate-test-docs`) -- only worth regenerating when a
    # staged change actually touches `test/`, unlike the API refresh
    # above, which is cheap enough to run on any staged Python change.
    test_files_staged=false
    for path in "${python_files[@]}"; do
        [[ "${path}" == test/* ]] && test_files_staged=true && break
    done
    if "${test_files_staged}"; then
        if [[ -x dev/bin/generate-test-docs ]] \
            && command -v pydoc-markdown >/dev/null 2>&1; then
            dev/bin/generate-test-docs
            git add -- test/TESTS.md
        else
            printf 'pre-commit: test-docs generator unavailable; refresh skipped\n'
        fi
    fi
fi

# Refresh the Help screen's generated HTML whenever a Tier 1 source doc,
# or the generator itself, is staged (design doc
# `20260822-claude-sonnet-5-in-app-help-design.md` §4.1's own freshness
# discipline, mirroring the API-doc refresh above).
help_sources_staged=false
while IFS= read -r -d '' path; do
    case "${path}" in
        doc/usage.md | doc/configuration.md \
            | dev/bin/generate-help-html | dev/lib/docslug.py)
            help_sources_staged=true
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if "${help_sources_staged}"; then
    if [[ -x dev/bin/generate-help-html ]] \
        && python3 -c 'import markdown_it' >/dev/null 2>&1; then
        dev/bin/generate-help-html
        git add -- src/fim/gui/webui/help
    else
        printf 'pre-commit: help-HTML generator unavailable; refresh skipped\n'
    fi
fi

# Reject newly added filenames that are not portable across supported systems.
ascii_check='import sys; data = sys.stdin.buffer.read().split(b"\0"); raise SystemExit(any(name and not name.isascii() for name in data))'
if ! git diff --cached --name-only --diff-filter=A -z \
    | python3 -c "${ascii_check}"
then
    printf 'pre-commit: newly added filenames must be ASCII\n' >&2
    exit 1
fi
