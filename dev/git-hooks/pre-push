#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

root=$(git rev-parse --show-toplevel)
cd -- "${root}"
PATH="${root}/bin:${PATH}"
export PATH

if [[ ! -f pyproject.toml ]]; then
    printf 'pre-push: pyproject.toml absent; gates skipped\n'
    exit 0
fi

if [[ "${PRE_PUSH_SKIP_LINT:-false}" != true ]]; then
    if command -v ruff >/dev/null 2>&1; then
        ruff check src test
    else
        printf 'pre-push: ruff absent; lint skipped\n'
    fi
fi
if [[ "${PRE_PUSH_SKIP_TYPE:-false}" != true ]]; then
    if command -v mypy >/dev/null 2>&1; then
        # No positional path: [tool.mypy] in pyproject.toml is the single
        # source of truth for scope (strict = true, files = ["src", "test"]).
        # An explicit "src" here would silently narrow that scope back to
        # src alone without changing the config -- see test/test_mypy_scope.py.
        mypy
    else
        printf 'pre-push: mypy absent; types skipped\n'
    fi
fi
if [[ "${PRE_PUSH_SKIP_TEST:-false}" != true ]]; then
    if command -v pytest >/dev/null 2>&1; then
        pytest -m 'not statistical and not slow and not packaging'
    else
        printf 'pre-push: pytest absent; tests skipped\n'
    fi
fi

# Verify generated documentation and always remove its temporary output.
if [[ "${PRE_PUSH_SKIP_DOCS:-false}" != true ]]; then
    if [[ -x dev/bin/generate-api-docs ]] \
        && command -v pydoc-markdown >/dev/null 2>&1
    then
        temporary=$(mktemp "${TMPDIR:-/tmp}/fim-api.XXXXXX")
        trap 'rm -f -- "${temporary}"' EXIT
        dev/bin/generate-api-docs "${temporary}"
        diff -u -- src/fim/API.md "${temporary}"
        rm -f -- "${temporary}"
        trap - EXIT
    else
        printf 'pre-push: API generator unavailable; docs skipped\n'
    fi
fi
