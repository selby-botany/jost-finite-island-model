#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd -- "${root}"
PATH="${root}/bin:${PATH}"
export PATH

advise=""
ci=false
coverage=false
dry_run=false
run_docs=true
run_lint=true
run_package=true
run_test=true
run_type=true

# Print command usage.
# Args:
#   None
# Returns:
#   0 after writing help
usage() {
    cat <<'EOF'
build — local CI equivalent for fim.

Copyright (C) 2026 Marie Selby Botanical Gardens
SPDX-License-Identifier: AGPL-3.0-or-later

SYNOPSIS
  build [--ci] [--coverage]
        [--no-lint] [--no-type] [--no-test] [--no-docs] [--no-package]
        [--advise [ADVISEMENTS]] [--advice [ADVISEMENTS]] [--no-advise]
        [--dry-run] [--help]

OPTIONS
  --ci                Run the full CI gate: --coverage plus every pytest
                      marker (including slow/statistical/gui/packaging,
                      which the bare default run excludes), plus a docs
                      drift check that fails if src/fim/API.md is out of
                      date instead of silently regenerating it. Cannot be
                      combined with any --no-* flag.
  --coverage          Run tests with branch-coverage instrumentation and
                      the 90% floor (pyproject.toml's
                      [tool.coverage.report]), instead of a bare pytest
                      run.
  --no-lint           Skip ruff check + ruff format --check.
  --no-type           Skip mypy (strict; src + test).
  --no-test           Skip the pytest suite entirely.
  --no-docs           Skip dev/bin/generate-api-docs and
                      dev/bin/check-doc-links.
  --no-package        Skip building the wheel/sdist and the
                      install-then-smoke-test step.
  --advise [ADVISEMENTS]
                      Run advisory checks -- informational only, never
                      fail the build regardless of what they find.
                      Comma-delimited list:
                      'security', 'bandit', 'churn', 'metrics',
                      'all', 'none'.
                      'all' selects every available advisement.
                      'none' disables all (equivalent to --no-advise).
                      Default with no list given: 'all'.
                      Advisory checks are off by default.
  --advice [ADVISEMENTS]
                      Synonym for --advise.
  --no-advise         Disable all advisory checks (equivalent to
                      --advise none).
  --dry-run           Print each command without executing it.
  --help              Print this message and exit.

ENVIRONMENT
  PYTHON              Python interpreter to run every stage under.
                      Default: python3 (resolved on PATH). Point this at
                      a venv's interpreter (e.g. .venv-312/bin/python3)
                      to pick up that venv's installed tools and console
                      scripts.

PREREQUISITES
  • Python 3.12 or newer
  • The [dev] extras installed: python -m pip install -e ".[dev]"
  • For --advise metrics only: docker (runs ghcr.io/boyter/scc)

STAGES (run in order; each can be skipped with --no-<stage>)
  1. Lint      — ruff check + ruff format --check
  2. Type      — mypy (strict; src + test)
  3. Test      — pytest; --coverage adds branch-coverage instrumentation
                 and the 90% floor; --ci additionally drops the default
                 marker filter to run every marker
  4. Docs      — regenerate src/fim/API.md and check every local
                 Markdown link; --ci fails on drift instead of silently
                 regenerating
  5. Package   — build the wheel/sdist, install it into a throwaway venv
                 (outside the checkout, so local source cannot mask a
                 packaging defect), and smoke-test fim --version/--help
                 from there
  6. Advise    — advisory checks (never block the build; opt in with
                 --advise)
             security  — pip-audit against the resolved dependency set
             bandit    — bandit source-pattern scan of src/
             churn     — per-file git commit frequency (top 40)
             metrics   — scc code-metrics summary (requires docker)

EXAMPLES
  # Local dev cycle — lint, type-check, test, docs, package
  ./build

  # The full gate CI runs
  ./build --ci

  # Fast iteration: skip everything except tests
  ./build --no-lint --no-type --no-docs --no-package

  # Full gate plus every advisory check
  ./build --ci --advise

  # Just the dependency-CVE and source-pattern scans, nothing else
  ./build --no-lint --no-type --no-test --no-docs --no-package \
      --advise security,bandit

  # Dry-run: just print each command
  ./build --dry-run
EOF
}

# Print and run one command, or only print it in dry-run mode.
# Args:
#   Command and arguments
# Returns:
#   The command's status, or 0 in dry-run mode
run() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
    "${dry_run}" && return 0
    "$@"
}

while (($#)); do
    case "$1" in
        --ci)
            ci=true
            coverage=true
            ;;
        --advise | --advice)
            # The value is optional (--advise alone means "all"), so only
            # consume $2 as the value when it looks like one -- a bare
            # trailing --advise, or one followed by another flag, must
            # not swallow that next flag as if it were an advisement list.
            if [[ $# -gt 1 && "$2" != --* ]]; then
                advise="$2"
                shift
            else
                advise="all"
            fi
            ;;
        --no-advise) advise="" ;;
        --coverage) coverage=true ;;
        --dry-run) dry_run=true ;;
        --no-docs) run_docs=false ;;
        --no-lint) run_lint=false ;;
        --no-package) run_package=false ;;
        --no-test) run_test=false ;;
        --no-type) run_type=false ;;
        --help)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if "${ci}" && {
    ! "${run_docs}" || ! "${run_lint}" || ! "${run_package}" \
        || ! "${run_test}" || ! "${run_type}"
}; then
    printf '%s\n' '--ci cannot be combined with a --no-* option' >&2
    exit 2
fi

# Resolve the requested advisory categories (comma-delimited) into one
# flag per category. The comma-list framework matches this project's
# own citrus-family build-script convention (dev/doc source:
# src/build/generate) so a future advisory category is additive here
# rather than a flag redesign. 'security' is pip-audit (dependency
# CVEs); 'bandit' is kept separate rather than folded into 'security'
# because it checks something different (source patterns, not resolved
# dependency versions) and citrus's own generator keeps the same two
# concerns apart (a gating image CVE scan vs. an advisory source scan).
run_advise_security=false
run_advise_bandit=false
run_advise_churn=false
run_advise_metrics=false
if [[ -n "${advise}" ]]; then
    IFS=',' read -ra advise_categories <<<"${advise}"
    for category in "${advise_categories[@]}"; do
        case "${category}" in
            all)
                run_advise_security=true
                run_advise_bandit=true
                run_advise_churn=true
                run_advise_metrics=true
                ;;
            security) run_advise_security=true ;;
            bandit) run_advise_bandit=true ;;
            churn) run_advise_churn=true ;;
            metrics) run_advise_metrics=true ;;
            none) ;;
            *)
                printf 'Unknown --advise category: %s\n' "${category}" >&2
                exit 2
                ;;
        esac
    done
fi

python=${PYTHON:-python3}

# Make console scripts from an explicitly selected virtual environment available.
if [[ "${python}" == */* ]]; then
    PATH="$(dirname -- "${python}"):${PATH}"
    export PATH
fi

# Report all unavailable development modules before starting a partial build.
if ! "${dry_run}"; then
    required_modules=()
    "${run_lint}" && required_modules[${#required_modules[@]}]=ruff
    "${run_type}" && required_modules[${#required_modules[@]}]=mypy
    if "${run_test}"; then
        required_modules[${#required_modules[@]}]=pytest
        "${coverage}" \
            && required_modules[${#required_modules[@]}]=pytest_cov
    fi
    "${run_docs}" && required_modules[${#required_modules[@]}]=pydoc_markdown
    "${run_package}" && required_modules[${#required_modules[@]}]=build
    "${run_advise_security}" \
        && required_modules[${#required_modules[@]}]=pip_audit
    "${run_advise_bandit}" && required_modules[${#required_modules[@]}]=bandit
    # churn (git+awk) and metrics (docker) are not Python modules, so
    # they are not part of this pre-check; each is verified for real
    # right before it runs (git already required to have a checkout at
    # all; docker's absence is reported clearly, not as a raw
    # command-not-found).

    if ! missing_modules=$(
        "${python}" - "${required_modules[@]}" <<'PY'
import importlib.util
import sys

print(
    " ".join(
        module
        for module in sys.argv[1:]
        if importlib.util.find_spec(module) is None
    )
)
PY
    ); then
        printf '%s\n' \
            'Unable to run the selected Python 3.12+ interpreter' >&2
        exit 1
    fi
    if [[ -n "${missing_modules}" ]]; then
        printf 'Missing Python development modules: %s\n' \
            "${missing_modules}" >&2
        printf '%s\n' \
            'Install them with: python -m pip install -e ".[dev]"' >&2
        exit 1
    fi
fi

if "${run_lint}"; then
    run "${python}" -m ruff check src test \
        dev/bin/check-doc-links dev/bin/extract-release-notes \
        dev/bin/calibrate-statistical-bands
    run "${python}" -m ruff format --check src test \
        dev/bin/check-doc-links dev/bin/extract-release-notes \
        dev/bin/calibrate-statistical-bands
fi

# No positional arguments: `[tool.mypy]` in pyproject.toml already sets
# `strict = true` and `files = ["src", "test"]`, so the bare invocation is
# the single source of truth for what the type gate covers. Passing an
# explicit `src` here (as before) would silently narrow that scope back
# to `src` alone without changing the config, letting the two drift apart
# again — see `test/test_mypy_scope.py`.
"${run_type}" && run "${python}" -m mypy

if "${run_test}"; then
    if "${coverage}"; then
        # The authoritative --ci gate runs every marker, including
        # `packaging` (R17) and the `slow`/`statistical` layers the fast
        # local default skips; dropping -m's argument entirely, rather
        # than negating every marker in turn, is what keeps a newly added
        # marker included here by default instead of silently excluded.
        pytest_marker_args=(-m 'not slow and not packaging')
        "${ci}" && pytest_marker_args=()
        run "${python}" -m pytest -o addopts= --strict-config \
            --strict-markers "${pytest_marker_args[@]}" \
            --cov=fim --cov-branch --cov-report=term-missing \
            --cov-fail-under=90
    else
        run "${python}" -m pytest
    fi
fi

if "${run_docs}"; then
    if "${ci}"; then
        api_temporary=$(mktemp "${TMPDIR:-/tmp}/fim-api.XXXXXX")
        trap 'rm -f -- "${api_temporary}"' EXIT
        run dev/bin/generate-api-docs "${api_temporary}"
        run diff -u -- src/fim/API.md "${api_temporary}"
        rm -f -- "${api_temporary}"
        trap - EXIT
    else
        run dev/bin/generate-api-docs
    fi
    run dev/bin/check-doc-links
fi

if "${run_package}"; then
    run "${python}" -m build
    if ! "${dry_run}"; then
        # Run outside the checkout so local source cannot mask wheel defects.
        smoke_venv=$(mktemp -d "${TMPDIR:-/tmp}/fim-smoke.XXXXXX")
        trap 'rm -rf -- "${smoke_venv}"' EXIT
        run "${python}" -m venv "${smoke_venv}"
        version=$(<version.txt)
        wheel="dist/fim-${version}-py3-none-any.whl"
        if [[ ! -f "${wheel}" ]]; then
            printf 'Built wheel not found: %s\n' "${wheel}" >&2
            exit 1
        fi
        run "${smoke_venv}/bin/python" -m pip install "${wheel}"
        (
            cd -- "${smoke_venv}"
            run "${smoke_venv}/bin/fim" --version
            run "${smoke_venv}/bin/fim" --help
        )
    fi
fi

if "${run_advise_security}"; then
    printf '\n== Advisory: security (pip-audit) ==\n'
    # `fim` itself is always skipped: it is not published to PyPI (an
    # editable local install), so "is this project vulnerable to
    # itself" is not a meaningful question -- only its resolved
    # third-party dependencies are worth auditing. Advisory only:
    # `|| true` means a real finding is printed but never fails the
    # build, matching every other advisory check's contract.
    run "${python}" -m pip_audit --skip-editable || true
fi

if "${run_advise_bandit}"; then
    printf '\n== Advisory: bandit (source-pattern scan) ==\n'
    # src/ only, matching the same scope citrus's own graudit advisory
    # scans (test/ triggering these same patterns is expected --
    # mocking a subprocess/network call is not the thing this check is
    # for). Advisory only: a real finding is printed but never fails
    # the build.
    run "${python}" -m bandit -r src -q || true
fi

if "${run_advise_churn}"; then
    printf '\n== Advisory: churn (per-file commit frequency) ==\n'
    # git + awk only, no external tool -- the 40 most-changed files,
    # newest-history-first, as a quick "where does most of the editing
    # happen" signal. Never fails the build.
    churn_output=$(
        git log --all --name-only --pretty=format: 2>/dev/null \
            | grep -v '^[[:space:]]*$' \
            | sort \
            | uniq -c \
            | sort -rn \
            | awk 'length($0) > 0 { printf "%s,%d\n", $2, $1 }' \
            | head -40
    ) || true
    if [[ -n "${churn_output}" ]]; then
        printf 'entity,n-revs\n'
        printf '%s\n' "${churn_output}"
    else
        printf 'Churn analysis skipped: no git history\n'
    fi
fi

if "${run_advise_metrics}"; then
    printf '\n== Advisory: metrics (scc code-metrics summary) ==\n'
    if command -v docker >/dev/null 2>&1; then
        run docker run --rm \
            --volume "${root}:/data:ro" \
            ghcr.io/boyter/scc:v3.7.0 \
            scc --by-file /data || true
    else
        printf 'Metrics skipped: docker not found (see --help PREREQUISITES)\n'
    fi
fi
