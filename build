#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd -- "${root}"
PATH="${root}/bin:${PATH}"
export PATH

ci=false
coverage=false
dry_run=false
run_docs=true
run_lint=true
run_package=true
run_test=true
run_type=true

# Print command usage.
# Args:
#   None
# Returns:
#   0 after writing help
usage() {
    cat <<'EOF'
Usage: build [--ci] [--coverage] [--dry-run]
             [--no-lint] [--no-type] [--no-test] [--no-docs] [--no-package]
             [--help]
EOF
}

# Print and run one command, or only print it in dry-run mode.
# Args:
#   Command and arguments
# Returns:
#   The command's status, or 0 in dry-run mode
run() {
    printf '+'
    printf ' %q' "$@"
    printf '\n'
    "${dry_run}" && return 0
    "$@"
}

while (($#)); do
    case "$1" in
        --ci)
            ci=true
            coverage=true
            ;;
        --coverage) coverage=true ;;
        --dry-run) dry_run=true ;;
        --no-docs) run_docs=false ;;
        --no-lint) run_lint=false ;;
        --no-package) run_package=false ;;
        --no-test) run_test=false ;;
        --no-type) run_type=false ;;
        --help)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if "${ci}" && {
    ! "${run_docs}" || ! "${run_lint}" || ! "${run_package}" \
        || ! "${run_test}" || ! "${run_type}"
}; then
    printf '%s\n' '--ci cannot be combined with a --no-* option' >&2
    exit 2
fi

python=${PYTHON:-python3}

# Make console scripts from an explicitly selected virtual environment available.
if [[ "${python}" == */* ]]; then
    PATH="$(dirname -- "${python}"):${PATH}"
    export PATH
fi

# Report all unavailable development modules before starting a partial build.
if ! "${dry_run}"; then
    required_modules=()
    "${run_lint}" && required_modules[${#required_modules[@]}]=ruff
    "${run_type}" && required_modules[${#required_modules[@]}]=mypy
    if "${run_test}"; then
        required_modules[${#required_modules[@]}]=pytest
        "${coverage}" \
            && required_modules[${#required_modules[@]}]=pytest_cov
    fi
    "${run_docs}" && required_modules[${#required_modules[@]}]=pydoc_markdown
    "${run_package}" && required_modules[${#required_modules[@]}]=build

    if ! missing_modules=$(
        "${python}" - "${required_modules[@]}" <<'PY'
import importlib.util
import sys

print(
    " ".join(
        module
        for module in sys.argv[1:]
        if importlib.util.find_spec(module) is None
    )
)
PY
    ); then
        printf '%s\n' \
            'Unable to run the selected Python 3.12+ interpreter' >&2
        exit 1
    fi
    if [[ -n "${missing_modules}" ]]; then
        printf 'Missing Python development modules: %s\n' \
            "${missing_modules}" >&2
        printf '%s\n' \
            'Install them with: python -m pip install -e ".[dev]"' >&2
        exit 1
    fi
fi

if "${run_lint}"; then
    run "${python}" -m ruff check src test \
        dev/bin/check-doc-links dev/bin/extract-release-notes \
        dev/bin/calibrate-statistical-bands
    run "${python}" -m ruff format --check src test \
        dev/bin/check-doc-links dev/bin/extract-release-notes \
        dev/bin/calibrate-statistical-bands
fi

# No positional arguments: `[tool.mypy]` in pyproject.toml already sets
# `strict = true` and `files = ["src", "test"]`, so the bare invocation is
# the single source of truth for what the type gate covers. Passing an
# explicit `src` here (as before) would silently narrow that scope back
# to `src` alone without changing the config, letting the two drift apart
# again — see `test/test_mypy_scope.py`.
"${run_type}" && run "${python}" -m mypy

if "${run_test}"; then
    if "${coverage}"; then
        # The authoritative --ci gate runs every marker, including
        # `packaging` (R17) and the `slow`/`statistical` layers the fast
        # local default skips; dropping -m's argument entirely, rather
        # than negating every marker in turn, is what keeps a newly added
        # marker included here by default instead of silently excluded.
        pytest_marker_args=(-m 'not slow and not packaging')
        "${ci}" && pytest_marker_args=()
        run "${python}" -m pytest -o addopts= --strict-config \
            --strict-markers "${pytest_marker_args[@]}" \
            --cov=fim --cov-branch --cov-report=term-missing \
            --cov-fail-under=90
    else
        run "${python}" -m pytest
    fi
fi

if "${run_docs}"; then
    if "${ci}"; then
        api_temporary=$(mktemp "${TMPDIR:-/tmp}/fim-api.XXXXXX")
        trap 'rm -f -- "${api_temporary}"' EXIT
        run dev/bin/generate-api-docs "${api_temporary}"
        run diff -u -- src/fim/API.md "${api_temporary}"
        rm -f -- "${api_temporary}"
        trap - EXIT
    else
        run dev/bin/generate-api-docs
    fi
    run dev/bin/check-doc-links
fi

if "${run_package}"; then
    run "${python}" -m build
    if ! "${dry_run}"; then
        # Run outside the checkout so local source cannot mask wheel defects.
        smoke_venv=$(mktemp -d "${TMPDIR:-/tmp}/fim-smoke.XXXXXX")
        trap 'rm -rf -- "${smoke_venv}"' EXIT
        run "${python}" -m venv "${smoke_venv}"
        version=$(<version.txt)
        wheel="dist/fim-${version}-py3-none-any.whl"
        if [[ ! -f "${wheel}" ]]; then
            printf 'Built wheel not found: %s\n' "${wheel}" >&2
            exit 1
        fi
        run "${smoke_venv}/bin/python" -m pip install "${wheel}"
        (
            cd -- "${smoke_venv}"
            run "${smoke_venv}/bin/fim" --version
            run "${smoke_venv}/bin/fim" --help
        )
    fi
fi
